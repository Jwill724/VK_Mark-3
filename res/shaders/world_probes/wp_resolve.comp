#version 460
#extension GL_GOOGLE_include_directive : require

#include "../include/world_probe_surface.glsl"
#include "../include/world_probe_packing.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rgba16f) uniform writeonly image2D outProbeLighting;

void main()
{
	ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
	ivec2 lowExtent = imageSize(outProbeLighting) / ivec2(1, 2);
	if (any(greaterThanEqual(hp, lowExtent))) return;
	SceneData scene = getSceneData();
	ivec2 fullExtent = SampleTextureSize(scene.renderTargetIDs.depthResolvedID, 0);
	ivec2 fp = wpResolveSourcePixel(hp, lowExtent, fullExtent);
	float raw = SampleTextureFetch(scene.renderTargetIDs.depthResolvedID, fp, 0).r;
	vec4 sky = vec4(0), bounce = vec4(0);
	if (raw > 0.0)
	{
		vec3 geometricNormalWS = normalize(mat3(scene.invView) * octDecode(
			SampleTextureFetch(scene.renderTargetIDs.viewNormalsID, fp, 0).rg * 2.0 - 1.0));
		wpPackLighting(wpEvaluateSurface(fp, fullExtent, raw, geometricNormalWS), sky, bounce);
	}
	imageStore(outProbeLighting, hp, sky);
	imageStore(outProbeLighting, hp + ivec2(0, lowExtent.y), bounce);
}
