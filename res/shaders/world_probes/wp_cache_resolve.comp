#version 460
#extension GL_GOOGLE_include_directive : require

#include "../include/world_probe_coefficients.glsl"
#include "../include/world_probe_cache_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rgba16f) uniform writeonly image3D outProbeSpatialCache;

layout(push_constant) uniform WorldProbeCachePush
{
	uint flags; // bit 0: fog; bit 1: directional transparent lighting
	uint pad0;
	uint pad1;
	uint pad2;
} pc;

void main()
{
	ivec3 extent = imageSize(outProbeSpatialCache) / ivec3(1, 1, WP_CACHE_SLABS);
	// Flatten Y/Z so the existing two-dimensional ComputeScope can dispatch us.
	// Dispatch extent is (gridX, gridY * gridZ), NOT the physical image dimensions.
	ivec3 cell = ivec3(int(gl_GlobalInvocationID.x),
		int(gl_GlobalInvocationID.y) % extent.y,
		int(gl_GlobalInvocationID.y) / extent.y);
	if (any(greaterThanEqual(cell, extent))) return;
	WPSpatialCacheInfoBuffer info = getWPSpatialCacheInfo();
	bool usable = info.depthBias.x > 0.0 && info.depthBias.y > info.depthBias.x;
	uint flags = usable ? (pc.flags & 3u) : 0u;
	vec4 mean = vec4(0);
	float exposure = max(getPreExposure(), 1e-8);
	if ((flags & 2u) != 0u)
	{
		WPCoefficients c = wpGatherCoefficients(wpCacheWorldPosition(cell, extent));
		float coverage = clamp(c.coverage, 0.0, 1.0);
		vec3 skyMean = vec3(0);
		for (int a = 0; a < 6; ++a)
		{
			vec3 sky = max(c.sky[a].rgb, vec3(0));
			skyMean += sky;
			imageStore(outProbeSpatialCache, cell + ivec3(0, 0, a * extent.z),
				vec4(sky * (coverage * exposure), clamp(c.sky[a].a, 0.0, 1.0) * coverage));
			imageStore(outProbeSpatialCache, cell + ivec3(0, 0, (a + 6) * extent.z),
				vec4(max(c.bounce[a], vec3(0)) * (coverage * exposure), coverage));
		}
		mean = vec4(skyMean * (coverage * exposure / 6.0), coverage);
	}
	else
	if ((flags & 1u) != 0u)
	{
		WPVolume v = sampleWorldProbesVolume(wpCacheWorldPosition(cell, extent));
		float coverage = v.valid ? clamp(v.coverage, 0.0, 1.0) : 0.0;
		mean = vec4(max(v.sky, vec3(0)) * (coverage * exposure), coverage);
	}
	// Directional slabs are unread when bit 1 is disabled. Both paths exist in
	// this single pipeline; enabling the bit rebuilds all directional slabs here.
	// Consumers must wait for this dispatch to complete.
	imageStore(outProbeSpatialCache,
		cell + ivec3(0, 0, WP_CACHE_MEAN_SLAB * extent.z), mean);
}
