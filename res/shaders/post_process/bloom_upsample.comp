#version 460

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D u_src;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, r11f_g11f_b10f) uniform image2D u_dst;

const float BLOOM_TAP_CEIL = 65504.0;

layout(push_constant) uniform BloomPush
{
	vec2  srcTexelSize;
	uvec2 dstRes;
	float filterRadius;
	uint  flags;
	float bloomThreshold;
	float bloomKnee;
} pc;

vec3 Sanitize(vec3 c)
{
	c = mix(c, vec3(0.0), isnan(c));
	return clamp(c, vec3(0.0), vec3(BLOOM_TAP_CEIL));
}

vec3 Tap(vec2 uv)
{
	return Sanitize(textureLod(u_src, uv, 0.0).rgb);
}

void main()
{
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	if (coord.x >= int(pc.dstRes.x) || coord.y >= int(pc.dstRes.y)) return;

	vec2 uv = (vec2(coord) + 0.5) / vec2(pc.dstRes);
	vec2 o  = pc.srcTexelSize * pc.filterRadius;

	vec3 a = Tap(uv + vec2(-o.x,  o.y));
	vec3 b = Tap(uv + vec2( 0.0,  o.y));
	vec3 c = Tap(uv + vec2( o.x,  o.y));

	vec3 d = Tap(uv + vec2(-o.x,  0.0));
	vec3 e = Tap(uv + vec2( 0.0,  0.0));
	vec3 f = Tap(uv + vec2( o.x,  0.0));

	vec3 g = Tap(uv + vec2(-o.x, -o.y));
	vec3 h = Tap(uv + vec2( 0.0, -o.y));
	vec3 i = Tap(uv + vec2( o.x, -o.y));

	vec3 tent = e * 4.0
			  + (b + d + f + h) * 2.0
			  + (a + c + g + i) * 1.0;
	tent *= (1.0 / 16.0);

	vec3 base = Sanitize(imageLoad(u_dst, coord).rgb);

	imageStore(u_dst, coord, vec4(base + tent, 1.0));
}