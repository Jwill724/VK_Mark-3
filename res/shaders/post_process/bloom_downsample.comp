#version 460

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D u_src;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D u_depth;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D u_dst;

#define BLOOM_FIRST_DOWNSAMPLE_BIT 1u

const float BLOOM_FIREFLY_LUMA = 8.0;

layout(push_constant) uniform BloomPush
{
	vec2  srcTexelSize;
	uvec2 dstRes;
	float filterRadius;
	uint  flags;
	float bloomThreshold;
	float bloomKnee;
} pc;

vec3 Sanitize(vec3 c)
{
	c = mix(c, vec3(0.0), isnan(c));
	return clamp(c, vec3(0.0), vec3(RESOLVE_TARGET_MAX));
}

vec3 ClampLuma(vec3 c, float maxLuma)
{
	float l = luminance(c);
	return c * min(1.0, maxLuma / max(l, EXPOSURE_MIN));
}

vec3 Tap(vec2 uv, float maxLuma)
{
	return ClampLuma(Sanitize(textureLod(u_src, uv, 0.0).rgb), maxLuma);
}

vec3 KarisAverage(vec3 c0, vec3 c1, vec3 c2, vec3 c3)
{
	float w0 = KarisWeight(c0);
	float w1 = KarisWeight(c1);
	float w2 = KarisWeight(c2);
	float w3 = KarisWeight(c3);
	return (c0 * w0 + c1 * w1 + c2 * w2 + c3 * w3) / max(w0 + w1 + w2 + w3, 1e-5);
}

float GeometryCoverage(vec2 uv, vec2 t)
{
	vec4 d0 = textureGather(u_depth, uv + vec2(-t.x, -t.y), 0);
	vec4 d1 = textureGather(u_depth, uv + vec2( t.x, -t.y), 0);
	vec4 d2 = textureGather(u_depth, uv + vec2(-t.x,  t.y), 0);
	vec4 d3 = textureGather(u_depth, uv + vec2( t.x,  t.y), 0);

	vec4 hits = step(vec4(1e-7), d0)
			  + step(vec4(1e-7), d1)
			  + step(vec4(1e-7), d2)
			  + step(vec4(1e-7), d3);

	return dot(hits, vec4(1.0)) * (1.0 / 16.0);
}

void main()
{
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	if (coord.x >= int(pc.dstRes.x) || coord.y >= int(pc.dstRes.y)) return;

	SceneData scene = getSceneData();

	vec2 uv = (vec2(coord) + 0.5) / vec2(pc.dstRes);
	vec2 t  = pc.srcTexelSize;

	bool  first   = (pc.flags & BLOOM_FIRST_DOWNSAMPLE_BIT) != 0u;
	float maxLuma = first ? BLOOM_FIREFLY_LUMA : RESOLVE_TARGET_MAX;

	vec3 a = Tap(uv + vec2(-2.0 * t.x,  2.0 * t.y), maxLuma);
	vec3 b = Tap(uv + vec2( 0.0,        2.0 * t.y), maxLuma);
	vec3 c = Tap(uv + vec2( 2.0 * t.x,  2.0 * t.y), maxLuma);

	vec3 d = Tap(uv + vec2(-2.0 * t.x,  0.0), maxLuma);
	vec3 e = Tap(uv + vec2( 0.0,        0.0), maxLuma);
	vec3 f = Tap(uv + vec2( 2.0 * t.x,  0.0), maxLuma);

	vec3 g = Tap(uv + vec2(-2.0 * t.x, -2.0 * t.y), maxLuma);
	vec3 h = Tap(uv + vec2( 0.0,       -2.0 * t.y), maxLuma);
	vec3 i = Tap(uv + vec2( 2.0 * t.x, -2.0 * t.y), maxLuma);

	vec3 j = Tap(uv + vec2(-t.x,  t.y), maxLuma);
	vec3 k = Tap(uv + vec2( t.x,  t.y), maxLuma);
	vec3 l = Tap(uv + vec2(-t.x, -t.y), maxLuma);
	vec3 m = Tap(uv + vec2( t.x, -t.y), maxLuma);

	vec3 result;
	if (first)
	{
		vec3 box0 = KarisAverage(a, b, d, e);
		vec3 box1 = KarisAverage(b, c, e, f);
		vec3 box2 = KarisAverage(d, e, g, h);
		vec3 box3 = KarisAverage(e, f, h, i);
		vec3 box4 = KarisAverage(j, k, l, m);
		result = box4 * 0.5 + (box0 + box1 + box2 + box3) * 0.125;

		float lum          = luminance(result);
		float amount       = softThreshold(lum, pc.bloomThreshold, pc.bloomKnee);
		result             = (amount > 0.0) ? result * (amount / max(lum, EXPOSURE_MIN)) : vec3(0.0);

		vec2 jitterUV = vec2(scene.temporalJitter.x, -scene.temporalJitter.y) * 0.5;
		result *= GeometryCoverage(uv + jitterUV, t);
	}
	else
	{
		result  = e * 0.125;
		result += (a + c + g + i) * 0.03125;
		result += (b + d + f + h) * 0.0625;
		result += (j + k + l + m) * 0.125;
	}

	imageStore(u_dst, coord, vec4(result, 1.0));
}