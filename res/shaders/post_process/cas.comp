#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"

const float RCAS_LIMIT = 0.25 - (1.0 / 16.0);

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inColor;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outColor;

layout(push_constant) uniform CASPush {
	float sharpness;
	float denoise;
	float hdrCompress;
} pc;

vec3 compressRange(vec3 c, float k)
{
	return c / (1.0 + k * max(c.r, max(c.g, c.b)));
}

vec3 expandRange(vec3 c, float k)
{
	return c / max(1.0 - k * max(c.r, max(c.g, c.b)), 1e-3);
}

vec3 tap(ivec2 p, ivec2 res, float k)
{
	vec3 c = texelFetch(inColor, clamp(p, ivec2(0), res - 1), 0).rgb;
	c = (any(isnan(c)) || any(isinf(c))) ? vec3(0.0) : max(c, vec3(0.0));
	return compressRange(c, k);
}

void main()
{
	ivec2 p   = ivec2(gl_GlobalInvocationID.xy);
	ivec2 res = imageSize(outColor);
	if (any(greaterThanEqual(p, res))) return;

	float k = pc.hdrCompress;

	vec3 e = tap(p,                   res, k);
	vec3 b = tap(p + ivec2( 0, -1),   res, k);
	vec3 d = tap(p + ivec2(-1,  0),   res, k);
	vec3 f = tap(p + ivec2( 1,  0),   res, k);
	vec3 h = tap(p + ivec2( 0,  1),   res, k);

	vec3 mn4 = min(min(b, d), min(f, h));
	vec3 mx4 = max(max(b, d), max(f, h));

	vec3 hitMin = mn4 / max(4.0 * mx4, vec3(1e-5));
	vec3 hitMax = (vec3(1.0) - mx4) / min(4.0 * mn4 - 4.0, vec3(-1e-5));

	vec3  lobeRGB = max(-hitMin, hitMax);
	float lobe    = max(-RCAS_LIMIT, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * pc.sharpness;

	if (pc.denoise > 0.0)
	{
		float bL = luminance(b);
		float dL = luminance(d);
		float eL = luminance(e);
		float fL = luminance(f);
		float hL = luminance(h);

		float span = max(max(max(bL, dL), max(fL, hL)), eL)
				   - min(min(min(bL, dL), min(fL, hL)), eL);

		float nz = saturate(abs(0.25 * (bL + dL + fL + hL) - eL) / max(span, 1e-5));
		lobe *= mix(1.0, 1.0 - 0.5 * nz, pc.denoise);
	}

	vec3 result = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);

	imageStore(outColor, p, vec4(expandRange(max(result, vec3(0.0)), k), 1.0));
}