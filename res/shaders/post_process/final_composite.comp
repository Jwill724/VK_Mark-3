#version 460

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/shadow.glsl"
#include "../include/depth.glsl"
#include "../include/froxel.glsl"
#include "../include/debug_views.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inSceneHDR;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D inDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler3D froxelIntegrated;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D lensFlareColorImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5) uniform sampler2D bloomImage;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D toneMapImage;

layout(push_constant) uniform CompositePush
{
	vec2 froxelClips;
	uint fogEnabled;
} pc;

const float GT_MAX_BRIGHTNESS   = 1.0;
const float GT_CONTRAST         = 1.0;
const float GT_LINEAR_START     = 0.22;
const float GT_LINEAR_LENGTH    = 0.4;
const float GT_BLACK_TIGHTNESS  = 1.33;
const float GT_PEDESTAL         = 0.0;

float GTCurve(float x)
{
	float P = GT_MAX_BRIGHTNESS;
	float a = GT_CONTRAST;
	float m = GT_LINEAR_START;
	float l = GT_LINEAR_LENGTH;
	float c = GT_BLACK_TIGHTNESS;
	float b = GT_PEDESTAL;

	float l0 = ((P - m) * l) / a;
	float S0 = m + l0;
	float S1 = m + a * l0;
	float C2 = (a * P) / (P - S1);
	float CP = -C2 / P;

	float w0 = 1.0 - smoothstep(0.0, m, x);
	float w2 = step(m + l0, x);
	float w1 = 1.0 - w0 - w2;

	float T = m * pow(x / m, c) + b;
	float L = m + a * (x - m);
	float S = P - (P - S1) * exp(CP * (x - S0));

	return T * w0 + L * w1 + S * w2;
}

vec3 TonemapGT(vec3 c)
{
	return vec3(GTCurve(c.r), GTCurve(c.g), GTCurve(c.b));
}

void main()
{
	ivec2 dim = imageSize(toneMapImage);
	ivec2 pid = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pid, dim))) return;

	vec2 uvFull = (vec2(pid) + 0.5) / vec2(dim);

	vec3 hdrScene = texelFetch(inSceneHDR, pid, 0).rgb;

	SceneData    scene = getSceneData();
	DebugToggles debug = getDebugToggles();

	bool debugViewing = false;
	if (debug.debugView != DBG_OFF || DBG(enableWireframe))
	{
		debugViewing = true;
		imageStore(toneMapImage, pid, vec4(hdrScene, 1.0));
	}

	if (pc.fogEnabled != 0u)
	{
		float rawDepth = texelFetch(inDepth, pid, 0).r;

		float viewDepth = (rawDepth <= DEPTH_EPSILON_REVERSED_Z)
			? pc.froxelClips.y
			: screenToViewDepth(rawDepth, scene.depthLinearizeMult, scene.depthLinearizeAdd);

		hdrScene = applyFroxelFog(
			froxelIntegrated, uvFull, viewDepth, hdrScene,
			pc.froxelClips.x, pc.froxelClips.y);
	}

	vec3 lensFlare = vec3(0.0);
	if (DBG(enableLensFlare) && !debugViewing) {
		lensFlare = textureLod(lensFlareColorImage, uvFull, 0.0).rgb;
	}

	vec3 hdr = max(hdrScene + lensFlare, 0.0);

	if (DBG(enableBloom) && !debugViewing) {
		vec3 bloom = texture(bloomImage, uvFull).rgb;
		hdr += bloom * debug.bloomIntensity;
	}

	vec3 mapped = clamp(TonemapGT(hdr), 0.0, 1.0);

	vec3 srgb = linearToSRGB(clamp(mapped, 0.0, 1.0));

	float noise = interleavedGradientNoise(pid) - 0.5;
	srgb = clamp(srgb + (noise * 0.75) / 255.0, 0.0, 1.0);

	mapped = sRGBToLinear(srgb);

	if (!debugViewing) {
		imageStore(toneMapImage, pid, vec4(mapped, 1.0));
	}
}