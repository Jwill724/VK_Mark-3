#version 460

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inColor;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outColor;

layout(push_constant) uniform ChromaticAberrationPushBlock
{
	float maxShiftPixels;
	float distortionAmount;
	float falloffExponent;
	uint  maxTaps;
} pc;

const float TAP_DENSITY  = 4.5;
const int   TAP_HARD_CAP = 16;

const float LAMBDA_RED   = 680.0;
const float LAMBDA_BLUE  = 440.0;
const float LAMBDA_GREEN = 0.5 * (LAMBDA_RED + LAMBDA_BLUE);

float dispersionOffset(float t)
{
	float lambda = mix(LAMBDA_RED, LAMBDA_BLUE, t);
	const float invG2 = 1.0 / (LAMBDA_GREEN * LAMBDA_GREEN);
	const float invR2 = 1.0 / (LAMBDA_RED * LAMBDA_RED);
	return (invG2 - 1.0 / (lambda * lambda)) / (invG2 - invR2);
}

vec3 spectralWeight(float t)
{
	vec3 d = vec3(t, t - 0.5, t - 1.0);
	return exp2(-12.0 * d * d);
}

void main()
{
	ivec2 outputDim = imageSize(outColor);
	ivec2 pixelPos  = ivec2(gl_GlobalInvocationID.xy);

	if (any(greaterThanEqual(pixelPos, outputDim))) return;

	vec2 invSourceDim = 1.0 / vec2(textureSize(inColor, 0));
	vec2 invOutputDim = 1.0 / vec2(outputDim);

	vec2 uv       = (vec2(pixelPos) + 0.5) * invOutputDim;
	vec2 centered = uv - 0.5;

	float aspect       = float(outputDim.x) / float(outputDim.y);
	vec2  radialVec    = vec2(centered.x * aspect, centered.y);
	float radialLength = length(radialVec);
	float maxRadius    = length(vec2(0.5 * aspect, 0.5));

	float radialT = saturate(radialLength / maxRadius);

	float distortionFactor = 1.0 + pc.distortionAmount * radialT * radialT;
	float zoom             = 1.0 / (1.0 + pc.distortionAmount);
	vec2  distortedUv      = 0.5 + centered * (zoom * distortionFactor);

	vec2 uvMin = 0.5 * invSourceDim;
	vec2 uvMax = 1.0 - uvMin;

	float shiftPixels = pow(max(radialT, 1e-6), pc.falloffExponent) * pc.maxShiftPixels;

	if (shiftPixels < 0.05)
	{
		imageStore(outColor, pixelPos, textureLod(inColor, clamp(distortedUv, uvMin, uvMax), 0.0));
		return;
	}

	vec2 radialDir = radialVec / max(radialLength, 1e-6);
	vec2 shiftUv   = radialDir * shiftPixels * invSourceDim;

	int tapCeiling = clamp(int(pc.maxTaps), 3, TAP_HARD_CAP);
	int taps       = clamp(int(ceil(shiftPixels * TAP_DENSITY)) + 1, 3, tapCeiling);

	vec3  accumColor  = vec3(0.0);
	vec3  accumWeight = vec3(0.0);
	float accumAlpha  = 0.0;

	for (int i = 0; i < taps; ++i)
	{
		float t = float(i) / float(taps - 1);

		vec2 sampleUv = clamp(distortedUv + shiftUv * dispersionOffset(t), uvMin, uvMax);
		vec4 tapColor = textureLod(inColor, sampleUv, 0.0);
		vec3 weight   = spectralWeight(t);

		accumColor  += tapColor.rgb * weight;
		accumWeight += weight;
		accumAlpha  += tapColor.a * weight.g;
	}

	vec4 result = vec4(accumColor / accumWeight, accumAlpha / accumWeight.g);

	imageStore(outColor, pixelPos, result);
}