#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"
#include "../include/depth.glsl"

const float TAA_HISTORY_SECONDS     = 0.35;
const float TAA_HISTORY_SECONDS_OIT = 0.09;
const float TAA_MIN_FRAMES          = 8.0;
const float TAA_MAX_HISTORY         = 128.0;
const float TAA_CLAMP_FRESH         = 1.0;
const float TAA_OIT_MIN_WEIGHT      = 1e-4;
const float TAA_REACTIVE_FRAMES     = 2.0;
const float TAA_SHADING_MIN_FRAMES  = 1.0;
const float TAA_SHADING_EPS         = 0.02;
const float TAA_SHADING_BIAS        = 0.015;
const float TAA_SHADING_BIAS_VIS    = 0.06;
const float TAA_SHADING_MIN_COVER   = 0.1;
const float TAA_SHADING_DOWNSCALE   = 8.0;
const float TAA_VIS_SCALE_RATIO     = 0.5;
const float TAA_FLOOR_DARK          = 0.05;
const float TAA_SPATIAL_FRAMES      = 8.0;
const float TAA_SPATIAL_DEPTH_REL   = 0.02;

const int TAA_TILE       = 16;
const int TAA_HALO       = 2;
const int TAA_TILE_WIDTH = TAA_TILE + 2 * TAA_HALO;
const int TAA_TILE_COUNT = TAA_TILE_WIDTH * TAA_TILE_WIDTH;
const int TAA_THREADS    = TAA_TILE * TAA_TILE;

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1)  uniform sampler2D inColorCurrent;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2)  uniform sampler2D inColorHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3)  uniform sampler2D inVelocity;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4)  uniform sampler2D inDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5)  uniform sampler2D inPrevDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_6)  uniform sampler2D inTransparentReveal;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_7)  uniform sampler2D inTransparentAccum;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_8)  uniform sampler2D inTransparentVelocity;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_9)  uniform sampler2D inShadingCurrent;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_10) uniform sampler2D inShadingHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image2D outColorResolved;

layout(push_constant) uniform TAAPush {
	float invDeltaTime;
	float clampGamma;
	float depthRejectScale;
	float motionSpeedScale;
	float sigmaFloor;
	float shadingResponse;
	float shadingRejectScale;
} pc;

shared vec4  sColor[TAA_TILE_COUNT];
shared float sViewZ[TAA_TILE_COUNT];
shared float sWeightTight[9];
shared float sWeightWide[25];

vec3 sanitize(vec3 c)
{
	return (any(isnan(c)) || any(isinf(c))) ? vec3(0.0) : max(c, vec3(0.0));
}

vec3 RGBToYCoCg(vec3 rgb)
{
	float co = rgb.r - rgb.b;
	float t  = rgb.b + co * 0.5;
	float cg = rgb.g - t;
	return vec3(t + cg * 0.5, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg)
{
	float t = ycocg.x - ycocg.z * 0.5;
	float g = ycocg.z + t;
	float b = t - ycocg.y * 0.5;
	return vec3(b + ycocg.y, g, b);
}

vec3 toWorkingSpace(vec3 linearRGB)
{
	float luma = max(linearRGB.r, max(linearRGB.g, linearRGB.b));
	return RGBToYCoCg(linearRGB / (1.0 + luma));
}

vec3 fromWorkingSpace(vec3 ycocg)
{
	vec3  rgb  = YCoCgToRGB(ycocg);
	float luma = max(rgb.r, max(rgb.g, rgb.b));
	return max(rgb / max(1.0 - luma, 1e-3), vec3(0.0));
}

vec3 clipToBox(vec3 center, vec3 extent, vec3 history, out float overshoot)
{
	vec3 offset = history - center;
	vec3 units  = abs(offset) / max(extent, vec3(1e-7));
	overshoot   = max(units.x, max(units.y, units.z));
	return (overshoot > 1.0) ? center + offset / overshoot : history;
}

vec3 sampleHistory(vec2 uv, vec2 resolution)
{
	vec2 samplePos = uv * resolution;
	vec2 texPos1   = floor(samplePos - 0.5) + 0.5;
	vec2 f         = samplePos - texPos1;

	vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
	vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
	vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
	vec2 w3 = f * f * (-0.5 + 0.5 * f);

	vec2 w12      = w1 + w2;
	vec2 invRes   = 1.0 / resolution;
	vec2 texPos0  = (texPos1 - 1.0)      * invRes;
	vec2 texPos3  = (texPos1 + 2.0)      * invRes;
	vec2 texPos12 = (texPos1 + w2 / w12) * invRes;

	vec3 result = vec3(0.0);
	result += texture(inColorHistory, vec2(texPos12.x, texPos0.y )).rgb * w12.x * w0.y;
	result += texture(inColorHistory, vec2(texPos0.x,  texPos12.y)).rgb * w0.x  * w12.y;
	result += texture(inColorHistory, vec2(texPos12.x, texPos12.y)).rgb * w12.x * w12.y;
	result += texture(inColorHistory, vec2(texPos3.x,  texPos12.y)).rgb * w3.x  * w12.y;
	result += texture(inColorHistory, vec2(texPos12.x, texPos3.y )).rgb * w12.x * w3.y;

	return max(result / (w12.x + w12.y - w12.x * w12.y), vec3(0.0));
}

struct TransparentTap
{
	vec2  velocity;
	float coverage;
};

TransparentTap sampleTransparent(ivec2 pixel)
{
	TransparentTap t;
	t.velocity = vec2(0.0);
	t.coverage = 0.0;

	float coverage = 1.0 - saturate(texelFetch(inTransparentReveal, pixel, 0).r);
	if (coverage <= 1e-4) return t;

	vec4 accum = texelFetch(inTransparentAccum, pixel, 0);
	vec2 vel   = texelFetch(inTransparentVelocity, pixel, 0).rg;

	if (any(isnan(accum)) || any(isinf(accum)) ||
		any(isnan(vel))   || any(isinf(vel))   ||
		accum.a <= TAA_OIT_MIN_WEIGHT) return t;

	t.velocity = vel / accum.a;
	t.coverage = coverage;
	return t;
}

float depthRejection(vec2 historyUV, vec2 currViewRange, float linMult, float linAdd)
{
	vec4 g = textureGather(inPrevDepth, historyUV, 0);

	float prevNear = screenToViewDepth(max(max(g.x, g.y), max(g.z, g.w)), linMult, linAdd);
	float prevFar  = screenToViewDepth(min(min(g.x, g.y), min(g.z, g.w)), linMult, linAdd);

	float currNear = currViewRange.x;
	float currFar  = currViewRange.y;

	float gap       = max(prevNear - currFar, currNear - prevFar);
	float tolerance = max(max(currFar - currNear, prevFar - prevNear), currNear * 0.02);

	return saturate((gap / tolerance - 1.0) * pc.depthRejectScale);
}

float shadingRejection(vec2 uv, vec2 historyUV, vec2 uvScale, float histScale)
{
	vec3 sc = texture(inShadingCurrent, uv * uvScale).rgb;
	if (sc.b < TAA_SHADING_MIN_COVER) return 0.0;

	vec2 curr = sc.rg / sc.b;

	vec2 hUV = historyUV * uvScale;
	vec4 gL  = textureGather(inShadingHistory, hUV, 0) * histScale;
	vec4 gV  = textureGather(inShadingHistory, hUV, 1);
	vec4 gC  = textureGather(inShadingHistory, hUV, 2);

	vec2  lo      = vec2( 1e30);
	vec2  hi      = vec2(-1e30);
	float lumaSum = 0.0;
	float count   = 0.0;

	for (int i = 0; i < 4; ++i)
	{
		if (gC[i] < TAA_SHADING_MIN_COVER) continue;

		vec2 h = vec2(gL[i], gV[i]) / gC[i];
		lo = min(lo, h);
		hi = max(hi, h);
		lumaSum += h.x;
		count   += 1.0;
	}

	if (count == 0.0) return 0.0;

	vec2 outside = max(max(lo - curr, curr - hi), vec2(0.0));

	float lumaDelta  = outside.x / (curr.x + lumaSum / count + TAA_SHADING_EPS);
	float lumaReject = saturate((lumaDelta - TAA_SHADING_BIAS)     * pc.shadingRejectScale);
	float visReject  = saturate((outside.y - TAA_SHADING_BIAS_VIS) * pc.shadingRejectScale * TAA_VIS_SCALE_RATIO);

	return max(lumaReject, visReject);
}

void main()
{
	SceneData scene = getSceneData();

	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 res   = ivec2(scene.renderExtentSize.xy);

	const vec2  invRes       = scene.renderPixelSizes.xy;
	const vec2  outRes       = vec2(res);
	const vec2  uv           = (vec2(pixel) + 0.5) * invRes;
	const float histScale    = getPreExposureDelta();
	const bool  historyValid = scene.temporal.y != 0u;

	const vec2 shadingUVScale = outRes / (vec2(textureSize(inShadingCurrent, 0)) * TAA_SHADING_DOWNSCALE);

	const float linMult = scene.depthLinearizeMult;
	const float linAdd  = scene.depthLinearizeAdd;

	vec2 jitterPx = scene.temporalJitter.xy * 0.5 * outRes;
	jitterPx.y    = -jitterPx.y;

	const uint tid      = gl_LocalInvocationIndex;
	const ivec2 tileBase = ivec2(gl_WorkGroupID.xy) * TAA_TILE - TAA_HALO;

	for (uint i = tid; i < uint(TAA_TILE_COUNT); i += uint(TAA_THREADS))
	{
		ivec2 local = ivec2(int(i) % TAA_TILE_WIDTH, int(i) / TAA_TILE_WIDTH);
		ivec2 src   = clamp(tileBase + local, ivec2(0), res - 1);

		vec4 c = texelFetch(inColorCurrent, src, 0);

		sColor[i] = vec4(toWorkingSpace(sanitize(c.rgb)), c.a);
		sViewZ[i] = screenToViewDepth(texelFetch(inDepth, src, 0).r, linMult, linAdd);
	}

	if (tid < 9u)
	{
		int i  = int(tid);
		vec2 d = vec2(float(i % 3 - 1), float(i / 3 - 1)) + jitterPx;
		sWeightTight[i] = exp(-2.29 * dot(d, d));
	}
	else if (tid < 34u)
	{
		int i  = int(tid) - 9;
		vec2 d = vec2(float(i % 5 - 2), float(i / 5 - 2)) + jitterPx;
		sWeightWide[i] = exp(-0.55 * dot(d, d));
	}

	barrier();

	if (pixel.x >= res.x || pixel.y >= res.y) return;

	const ivec2 lp = ivec2(gl_LocalInvocationID.xy) + TAA_HALO;
	const int   ci = lp.y * TAA_TILE_WIDTH + lp.x;

	// 1. reproject
	ivec2 nearestPx = pixel;
	float nearestZ  = 1e30;
	float viewZMin  = 1e30;
	float viewZMax  = -1e30;

	for (int y = -1; y <= 1; ++y) {
		for (int x = -1; x <= 1; ++x) {
			float z = sViewZ[ci + y * TAA_TILE_WIDTH + x];
			viewZMin = min(viewZMin, z);
			viewZMax = max(viewZMax, z);
			if (z < nearestZ) { nearestZ = z; nearestPx = clamp(pixel + ivec2(x, y), ivec2(0), res - 1); }
		}
	}

	vec2 velocity = texelFetch(inVelocity, nearestPx, 0).rg;

	TransparentTap trans = sampleTransparent(pixel);
	velocity = mix(velocity, trans.velocity, trans.coverage);

	vec2  historyUV = uv - velocity;
	float motion    = saturate(length(velocity * outRes) * pc.invDeltaTime * pc.motionSpeedScale);

	// 2. moments and tight filter
	vec3  m1 = vec3(0.0);
	vec3  m2 = vec3(0.0);
	vec3  tight  = vec3(0.0);
	float tightW = 0.0;

	for (int y = -1; y <= 1; ++y) {
		for (int x = -1; x <= 1; ++x) {
			vec3  c = sColor[ci + y * TAA_TILE_WIDTH + x].rgb;
			float w = sWeightTight[(y + 1) * 3 + (x + 1)];

			m1 += c;
			m2 += c * c;

			tight  += c * w;
			tightW += w;
		}
	}

	vec3 mean  = m1 / 9.0;
	vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));

	bool offscreen = any(lessThan(historyUV, vec2(0.0))) || any(greaterThan(historyUV, vec2(1.0)));

	float targetFrames = clamp(
		mix(TAA_HISTORY_SECONDS, TAA_HISTORY_SECONDS_OIT, trans.coverage) * pc.invDeltaTime,
		TAA_MIN_FRAMES, TAA_MAX_HISTORY);

	// 3. history length and rejection
	float frames = 0.0;

	if (historyValid && !offscreen)
	{
		vec4 gathered = textureGather(inColorHistory, historyUV, 3);
		frames = min(min(gathered.x, gathered.y), min(gathered.z, gathered.w)) * TAA_MAX_HISTORY;

		float rejected      = max(motion, depthRejection(historyUV, vec2(viewZMin, viewZMax), linMult, linAdd));
		float shadingReject = shadingRejection(uv, historyUV, shadingUVScale, histScale);

		float reactive       = sColor[ci].a;
		float reactiveFrames = mix(targetFrames, TAA_REACTIVE_FRAMES,    reactive);
		float shadingFrames  = mix(targetFrames, TAA_SHADING_MIN_FRAMES, shadingReject);

		frames = min(frames, min(reactiveFrames, shadingFrames)) * (1.0 - rejected);
	}

	// 4. spatial fallback only where confidence is low
	vec3  current = tight / max(tightW, 1e-5);
	float spatial = 1.0 - saturate(frames / TAA_SPATIAL_FRAMES);

	if (spatial > 0.0)
	{
		float depthScale = 1.0 / max(sViewZ[ci] * TAA_SPATIAL_DEPTH_REL, 1e-3);

		vec3  wide  = vec3(0.0);
		float wideW = 0.0;

		for (int y = -2; y <= 2; ++y) {
			for (int x = -2; x <= 2; ++x) {
				int   ti = ci + y * TAA_TILE_WIDTH + x;
				float ww = sWeightWide[(y + 2) * 5 + (x + 2)]
						 * exp(-abs(sViewZ[ti] - sViewZ[ci]) * depthScale);

				wide  += sColor[ti].rgb * ww;
				wideW += ww;
			}
		}

		current = mix(current, wide / max(wideW, 1e-5), spatial);
	}

	// 5. constrain
	float trust = frames / targetFrames;

	float t        = clamp(mean.x, 0.0, 1.0);
	vec3  boxFloor = vec3(pc.sigmaFloor * max(t * (1.0 - t), TAA_FLOOR_DARK));
	vec3  extent   = max(sigma * mix(TAA_CLAMP_FRESH, pc.clampGamma, trust), boxFloor);

	// 6. blend
	vec3  history   = mean;
	float overshoot = 0.0;

	if (frames > 0.0)
	{
		vec3 historyRaw = toWorkingSpace(sanitize(sampleHistory(historyUV, outRes)) * histScale);
		history = clipToBox(mean, extent, historyRaw, overshoot);
	}

	float blend = max(1.0 / (frames + 1.0), saturate((overshoot - 1.0) * pc.shadingResponse));

	vec3 resolved = fromWorkingSpace(mix(history, current, blend));

	imageStore(outColorResolved, pixel,
		vec4(min(resolved, vec3(COLOR_HISTORY_MAX)), min(frames + 1.0, targetFrames) / TAA_MAX_HISTORY));
}