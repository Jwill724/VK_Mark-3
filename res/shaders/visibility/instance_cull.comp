#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/culling.glsl"
#include "../include/depth.glsl"
#include "../include/common.glsl"
#include "../include/shadow.glsl"
#include "../include/clustered.glsl"

// EVERY renderer instance within InstanceInput processes through here to be culled to a VisibleInstance type.
// Visibility bitmasks are tagged to each instance group (opaque, shadows, etc). Draw building uses this list,
// to define a DrawInstanceIDs list that efficiently traverses InstanceInput buffer.

layout(local_size_x = 256) in;

void addVisibleStats(uint mask)
{
	switch(mask)
	{
		case VIS_SLOT_OPAQUE:
		case VIS_SLOT_OPAQUE_MASKED:
			atomicAdd(getGPUStatsBuffer().gpuStats.visibleOpaque, 1u);
			return;
		case VIS_SLOT_TRANSPARENT:
			atomicAdd(getGPUStatsBuffer().gpuStats.visibleTransparent, 1u);
			return;

		case VIS_SLOT_FLASHLIGHT:
		case VIS_SLOT_CSM0:
		case VIS_SLOT_CSM1:
		case VIS_SLOT_CSM2:
		case VIS_SLOT_VOLUMETRIC:
			atomicAdd(getGPUStatsBuffer().gpuStats.visibleShadowCasters, 1u);
			return;
	}
}

void markVisible(InstanceVisibilityBuffer visCounters, uint slot, bool statsEnabled)
{
	atomicAdd(visCounters.counters.counts[slot], 1u);
	if (statsEnabled)
	{
		addVisibleStats(slot);
	}
}

void main()
{
	uint instanceID = gl_GlobalInvocationID.x;
	DebugToggles debug = getDebugToggles();
	uint instanceCount = debug.activeInstanceCount;
	if (instanceID >= instanceCount) return;

	InstanceVisibilityBuffer visCounters  = getInstanceVisibilityBuffer();
	VisibleCountBuffer visibleCount       = getVisibleCountBuffer();
	InstanceInput instance                = getInstanceInputBuffer().instanceInputs[instanceID];
	mat4 transform                        = getInstanceTransform(instance);
	Mesh mesh                             = getMeshBuffer().meshes[instance.meshID];
	AABB worldAABB                        = TransformAABB(mesh.localAABB, transform);
	SceneData sceneData                   = getSceneData();
	ShadowCSM csm                         = getShadowCSM();

	vec3  center = 0.5 * (worldAABB.vmin + worldAABB.vmax);
	float radius = mesh.localBoundingRadius * max_world_scale(transform);

	bool survives = (instance.flags & ALWAYS_VISIBLE) != 0u;

	if (!survives)
	{
		mat4 vp = sceneData.viewProj;
		vec4 pl, pr, pb, pt;
		get_frustum_side_planes(vp, pl, pr, pb, pt);

		// Frustum cull
		if (sphere_in_side_planes(center, radius, pl, pr, pb, pt))
			survives = true;
	}

	uint visMask = 0u;

	bool statsTracking = DBG(enableProfilerView);

	bool isAlphaMasked = (instance.flags & ALPHA_TESTED) != 0u;
	bool isDoubleSided = (instance.flags & DOUBLE_SIDED) != 0u;
	bool isFoliage     = (instance.flags & IS_TREE) != 0u;

	if (survives)
	{
		// primary
		if ((instance.flags & PASS_OPAQUE) != 0u)
		{
			uint slot = (isAlphaMasked || isDoubleSided || isFoliage)
				? VIS_SLOT_OPAQUE_MASKED
				: VIS_SLOT_OPAQUE;

			visMask |= (1u << slot);
			markVisible(visCounters, slot, statsTracking);
		}
		else if ((instance.flags & PASS_TRANSPARENT) != 0u)
		{
			visMask |= (1u << VIS_SLOT_TRANSPARENT);
			markVisible(visCounters, VIS_SLOT_TRANSPARENT, statsTracking);
		}

		// flashlight — opaque surviving only
		if (DBG(enableShadows) && DBG(enableFlashlight) &&
			(instance.flags & PASS_OPAQUE) != 0u &&
			(instance.flags & CAST_FLASHLIGHT) != 0u)
		{
			LocalLight flashlight = getLightBuffer().lights[LIGHT_LIST_SLOT_FLASHLIGHT];

			float distToLight = length(center - flashlight.position) - radius;
			bool inRange      = distToLight <= flashlight.radius;

			bool flashlightVisible = false;

			if (inRange)
			{
				vec4 fl, fr, fb, ft;
				get_frustum_side_planes(sceneData.flashlightVP, fl, fr, fb, ft);

				flashlightVisible = sphere_in_side_planes(center, radius, fl, fr, fb, ft);
			}

			if (flashlightVisible)
			{
				visMask |= (1u << VIS_SLOT_FLASHLIGHT);
				markVisible(visCounters, VIS_SLOT_FLASHLIGHT, statsTracking);
			}
		}
	}

	// Surface CSM — opaque only, test all instances
	if (DBG(enableShadows) &&
		debug.sunShadowFilter != SUN_SHADOW_FILTER_RT_SOFT &&
		!DBG(csmAtlasCached) &&
		(instance.flags & PASS_OPAQUE) != 0u &&
		(instance.flags & CAST_CSM) != 0u)
	{
		ShadowCullDataBuffer shadowCull = getShadowCullDataBuffer();

		vec3 extentWS = 0.5 * (worldAABB.vmax - worldAABB.vmin);
		float lsEpsilon = csm.params.w;

		uvec4 activeCascades = shadowCull.data.cascadeActive;

		for (uint c = 0u; c < uint(csm.params.y); ++c)
		{
			// cascade deactivation
			uint isActive = (c == 0u) ? activeCascades.x : (c == 1u) ? activeCascades.y
						  : (c == 2u) ? activeCascades.z : activeCascades.w;
			if (isActive == 0u) continue;

			if (isAlphaMasked && !isFoliage && c >= 2u) continue;
			if (isAlphaMasked &&  isFoliage && c >= 3u) continue;

			// sub-texel rejection — caster smaller than one shadow texel
			// contributes nothing to this cascade
			if (radius < csm.cascadeWorldTexels[c]) continue;

			// tight receiver footprint test in light space
			if (!casterOverlapsReceivers(
				center, extentWS,
				csm.cascadeLightViews[c],
				shadowCull.data.receiverLSMin[c].xyz,
				shadowCull.data.receiverLSMax[c].xyz,
				lsEpsilon)) continue;

			uint slot = VIS_SLOT_CSM0 + c;
			visMask |= (1u << slot);
			markVisible(visCounters, slot, statsTracking);
		}
	}

	// Volumetric shadows
	if (DBG(enableVolumetrics) &&
		(instance.flags & PASS_OPAQUE) != 0u &&
		(instance.flags & CAST_CSM) != 0u)
	{
		VolumetricShadowInfo volShadow = getVolumetricShadowInfo();

		vec3 extentWS = 0.5 * (worldAABB.vmax - worldAABB.vmin);

		// Aggressive sub-texel caster rejection.
		//
		// Trees get more leniency because their small-scale
		// silhouette contributes strongly to light shafts.
		const float cascadeWorldTexel = volShadow.params.y;
		float minRadius = cascadeWorldTexel * (isFoliage ? 0.5 : 1.0);

		if (radius >= minRadius &&
			casterOverlapsVolumetricReceivers(
				center, extentWS,
				volShadow.cascadeLightView,
				volShadow.receiverLSMin.xyz,
				volShadow.receiverLSMax.xyz,
				volShadow.receiverLSMax.w,
				volShadow.params.w))
		{
			visMask |= (1u << VIS_SLOT_VOLUMETRIC);
			markVisible(visCounters, VIS_SLOT_VOLUMETRIC, statsTracking);
		}
	}

	bool hasPrimary =
		(visMask &
			(VIS_PRIMARY_OPAQUE |
			 VIS_PRIMARY_OPAQUE_MASKED |
			 VIS_PRIMARY_TRANSPARENT)) != 0u;

	bool needsEntry = visMask != 0u;

	if (needsEntry)
	{
		uint visId = atomicAdd(visibleCount.count, 1u);

		uint primaryLodIdx = hasPrimary
			? selectLODIndex(
				instance,
				center,
				radius,
				sceneData.cameraPos.xyz,
				sceneData.projUnjittered[1][1])
			: LOD_IDX_BASE;

		VisibleInstance visInst;

		visInst.instanceID      = instanceID;
		visInst.primaryLodIndex = primaryLodIdx;
		visInst.primaryMesh     = meshFromLODIndex(
			instance,
			primaryLodIdx);
		visInst.visMask         = visMask;

		getVisibleInstanceBuffer().visibles[visId] = visInst;
	}
}
