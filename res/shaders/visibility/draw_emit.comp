#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require
#include "../include/common.glsl"
#include "../include/culling.glsl"
#include "../include/barycentric.glsl"
#include "../include/visbuffer.glsl"

// Core draw building stage using binned info to create an optimized array for instance access.

layout(local_size_x = 256) in;

shared uint sChunkTotal;
shared uint sScan[256];

const uint TASK_MAX_TOTAL_WORKGROUPS = 4194304u;

uint exclusiveScan256(uint value)
{
	uint tid = gl_LocalInvocationIndex;
	sScan[tid] = value;
	barrier();

	for (uint offset = 1u; offset < 256u; offset <<= 1u)
	{
		uint n = 0u;
		if (tid >= offset) n = sScan[tid - offset];
		barrier();
		sScan[tid] += n;
		barrier();
	}

	return sScan[tid] - value; // inclusive -> exclusive
}

void addDrawStats(uint mask, uint triangleCount)
{
	switch(mask)
	{
		case VIS_SLOT_OPAQUE:
		case VIS_SLOT_OPAQUE_MASKED:
			//atomicAdd(getGPUStatsBuffer().gpuStats.opaqueDrawCount, 1u);
			atomicAdd(getGPUStatsBuffer().gpuStats.triangleCount, triangleCount);
			return;
		case VIS_SLOT_TRANSPARENT:
			//atomicAdd(getGPUStatsBuffer().gpuStats.transparentDrawCount, 1u);
			atomicAdd(getGPUStatsBuffer().gpuStats.triangleCount, triangleCount);
			return;

//		case VIS_SLOT_FLASHLIGHT:
//		case VIS_SLOT_CSM0:
//		case VIS_SLOT_CSM1:
//		case VIS_SLOT_CSM2:
//			atomicAdd(getGPUStatsBuffer().gpuStats.shadowDrawCount, 1u);
//			return;
	}
}

void main()
{
	uint slot = gl_WorkGroupID.y;
	uint tid  = gl_LocalInvocationIndex;

	DrawBinCounterBuffer     binCounters = getDrawBinCounterBuffer();
	DrawBinBuffer            bins        = getDrawBinBuffer();
	IndirectDrawCountsBuffer drawCounts  = getIndirectDrawCountsBuffer();
	TaskDispatchBuffer       tasks       = getTaskDispatchBuffer();
	MeshBuffer               meshes      = getMeshBuffer();
	DrawBinKeysBuffer        keyTable    = getDrawBinKeyBuffer();
	DebugToggles             debug       = getDebugToggles();

	// Shadow draws start at flashlight shadow map
	bool isShadowStream = (slot >= TASK_MAX_FLASHLIGHT);

	// Region caps — one counter feeds both arrays, so each write is guarded against its own region.
	uint maxDraws = maxDrawsForSlot(slot);
	uint maxTasks = maxTaskDispatches(slot);

	uint drawBase = streamDrawBase(slot);
	uint taskBase = streamTaskBase(slot);

	if (tid == 0u) sChunkTotal = 0u;
	barrier();

	for (uint chunk = 0u; chunk < MAX_DRAW_BINS; chunk += 256u)
	{
		uint binID   = chunk + tid;
		uint flatIdx = slot * MAX_DRAW_BINS + binID;
		uint count   = binCounters.drawBinCounters[flatIdx];

		uint offsetInChunk = exclusiveScan256(count);
		uint binOffset     = sChunkTotal + offsetInChunk;

		if (count > 0u)
		{
			bins.drawBins[flatIdx].instanceOffset = binOffset;
			bins.drawBins[flatIdx].instanceCount  = count;

			// reset counter -> becomes intra-bin cursor for place pass
			binCounters.drawBinCounters[flatIdx] = 0u;

			uint  drawIdx = atomicAdd(drawCounts.counts[slot], 1u);
			uvec2 mm      = keyTable.dense[binID];
			Mesh  mesh    = meshes.meshes[mm.x];

			uint indexCount   = isShadowStream ? mesh.shadowIndexCount : mesh.indexCount;
			uint firstIndex   = isShadowStream ? mesh.shadowFirstIndex : mesh.firstIndex;
			uint instanceBase = streamInstanceBase(slot) + binOffset;

			// Task dispatch record
			if (maxTasks > 0u && drawIdx < maxTasks)
			{
				uint meshletOffset  = isShadowStream ? mesh.shadowMeshletOffset : mesh.meshletOffset;
				uint meshletCount   = isShadowStream ? mesh.shadowMeshletCount  : mesh.meshletCount;
				uint visibilityBase = isShadowStream ? 0u : mesh.meshletVisibilityBase;

				if (DBG(enableProfilerView) && !isShadowStream)
				{
					atomicAdd(getGPUStatsBuffer().gpuStats.meshletsSubmitted, meshletCount * count);
				}

				uint groupsX = (meshletCount + TASK_GROUP_SIZE - 1u) / TASK_GROUP_SIZE;

				uint groupsY = count;
				if (groupsX > 0u)
				{
					uint maxY = max(TASK_MAX_TOTAL_WORKGROUPS / groupsX, 1u);
					groupsY   = min(count, maxY);
				}
				else
				{
					groupsY = 0u; // meshletless mesh -> dispatch nothing
				}

				TaskDispatch td;
				td.groupCountX   = groupsX;
				td.groupCountY   = groupsY;
				td.groupCountZ   = (groupsX > 0u && groupsY > 0u) ? 1u : 0u;
				td.instanceBase  = instanceBase;
				td.meshletOffset = meshletOffset;
				td.meshletCount  = meshletCount;
				td.vertexOffset  = mesh.vertexOffset;
				td.visibilityBase = visibilityBase;

				tasks.taskDispatch[taskBase + drawIdx] = td;
			}

			// stats
			if (DBG(enableProfilerView))
			{
				addDrawStats(slot, (indexCount / 3u) * count);
			}
		}

		barrier();
		if (tid == 255u) sChunkTotal += offsetInChunk + count;
		barrier();
	}
}
