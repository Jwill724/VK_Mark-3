#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/depth.glsl"
#include "../include/ssgi_push.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

// R = AO, G = central temporal variance, B = effective observation count,
// A = consecutive frames without a sufficiently supported observation.
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rgba16f) writeonly uniform image2D outAOHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2, rgba8) writeonly uniform image2D outBentAO;

uint getAOHistoryReadID(RenderTargetIDs rt, uint frameIndex)
{
	return (frameIndex & 1u) != 0u ? rt.aoHistoryBID : rt.aoHistoryAID;
}

vec4 aoEmptyHistory()
{
	return vec4(1.0, 0.0, 0.0, 0.0);
}

vec2 aoReadObservation(RenderTargetIDs rt, ivec2 p)
{
	vec2 v = SampleTextureFetch(rt.aoReconstructionID, p, 0).rg;
	if (!aoFinite(v.x) || !aoFinite(v.y)) return vec2(1.0, 0.0);
	return clamp(v, vec2(0.0), vec2(1.0));
}

bool aoReprojectHistory(
	SceneData s, RenderTargetIDs rt, ivec2 p, ivec2 full,
	float currentZ, vec3 currentNormalWS,
	out vec4 history, out float footprintSupport)
{
	history = aoEmptyHistory();
	footprintSupport = 0.0;
	if (pc.aoHistoryValid == 0u || s.temporal.y != 1u) return false;

	vec2 uv = (vec2(p) + 0.5) / vec2(full);
	vec2 prevUV = uv - SampleTextureFetch(rt.velocityID, p, 0).rg;
	if (!all(greaterThanEqual(prevUV, vec2(0.0))) ||
		!all(lessThan(prevUV, vec2(1.0)))) return false;

	vec3 currentVS = cheapReconstructViewPos(uv, currentZ, s.ndcToViewMult, s.ndcToViewAdd);
	vec3 currentWS = (s.invView * vec4(currentVS, 1.0)).xyz;
	float expectedZ = -(s.prevView * vec4(currentWS, 1.0)).z;
	if (!aoFinite(expectedZ) || expectedZ <= 0.0) return false;

	uint historyID = getAOHistoryReadID(rt, s.temporal.x);
	vec2 historyPixel = prevUV * vec2(full) - 0.5;
	ivec2 base = ivec2(floor(historyPixel));
	vec2 f = fract(historyPixel);
	float sumAO = 0.0;
	float sumSecondMoment = 0.0;
	float sumAge = 0.0;
	float sumMissing = 0.0;
	float weightSum = 0.0;

	for (int k = 0; k < 4; ++k)
	{
		ivec2 o = ivec2(k & 1, k >> 1);
		ivec2 q = base + o;
		if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, full))) continue;
		float w =
			(o.x == 0 ? 1.0 - f.x : f.x) *
			(o.y == 0 ? 1.0 - f.y : f.y);
		if (w <= 0.0) continue;

		float raw = SampleTextureFetch(rt.prevDepthResolvedID, q, 0).r;
		if (!(raw > 0.0)) continue;
		float z = screenToViewDepth(raw, s.depthLinearizeMult, s.depthLinearizeAdd);
		if (!aoFinite(z) || z <= 0.0 ||
			abs(z - expectedZ) >= expectedZ * pc.aoDepthTolerance) continue;
		vec3 normalWS = normalize(mat3(s.prevInvView) * octDecode(
			SampleTextureFetch(rt.prevViewNormalsID, q, 0).rg * 2.0 - 1.0));
		if (!(dot(currentNormalWS, normalWS) > pc.aoNormalThreshold)) continue;

		vec4 h = SampleTextureFetch(historyID, q, 0);
		if (!aoFinite(h.r) || !aoFinite(h.g) || !aoFinite(h.b) || !aoFinite(h.a) ||
			h.b <= AO_SUPPORT_EPSILON || h.a >= pc.aoMissingMaxFrames) continue;
		h.r = clamp(h.r, 0.0, 1.0);
		h.g = clamp(h.g, 0.0, 0.25);
		sumAO += h.r * w;
		// Include disagreement between reprojected means in the variance.
		sumSecondMoment += (h.g + h.r * h.r) * w;
		sumAge += clamp(h.b, 0.0, pc.aoMaxHistorySamples) * w;
		sumMissing += clamp(h.a, 0.0, pc.aoMissingMaxFrames) * w;
		weightSum += w;
	}

	if (weightSum <= AO_SUPPORT_EPSILON) return false;
	float mean = sumAO / weightSum;
	history = vec4(mean,
		max(sumSecondMoment / weightSum - mean * mean, 0.0),
		sumAge / weightSum, sumMissing / weightSum);
	footprintSupport = clamp(weightSum, 0.0, 1.0);
	return true;
}

bool aoNeighborhood(
	RenderTargetIDs rt, ivec2 p, ivec2 full, float centerZ, vec3 centerNormalVS,
	out float low, out float high, out float variance)
{
	low = 1.0;
	high = 0.0;
	variance = 0.0;
	float sum = 0.0;
	float sum2 = 0.0;
	float weightSum = 0.0;

	for (int y = -1; y <= 1; ++y)
	for (int x = -1; x <= 1; ++x)
	{
		ivec2 q = p + ivec2(x, y);
		if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, full))) continue;
		vec2 observation = aoReadObservation(rt, q);
		if (observation.y < pc.aoNeighborConfidence) continue;
		float z = SampleTextureFetch(rt.linearizedHiZID, q, 0).r;
		if (!aoFinite(z) || z <= 0.0 ||
			abs(z - centerZ) >= centerZ * pc.aoDepthTolerance) continue;
		vec3 n = octDecode(SampleTextureFetch(rt.viewNormalsID, q, 0).rg * 2.0 - 1.0);
		if (!(dot(centerNormalVS, n) > pc.aoNormalThreshold)) continue;
		float w = observation.y;
		low = min(low, observation.x);
		high = max(high, observation.x);
		sum += observation.x * w;
		sum2 += observation.x * observation.x * w;
		weightSum += w;
	}

	if (weightSum <= AO_SUPPORT_EPSILON) return false;
	float mean = sum / weightSum;
	variance = max(sum2 / weightSum - mean * mean, 0.0);
	return true;
}

vec4 aoCarryMissing(vec4 history)
{
	float previousMissing = history.a;
	float missing = previousMissing + 1.0;
	if (missing >= pc.aoMissingMaxFrames) return aoEmptyHistory();

	// Hold through one quad cycle, then fade unsupported history to neutral.
	// The ratio gives a linear fade despite repeatedly applying this update.
	float previousRemaining = pc.aoMissingMaxFrames - max(previousMissing, pc.aoMissingHoldFrames);
	float remaining = pc.aoMissingMaxFrames - max(missing, pc.aoMissingHoldFrames);
	float keep = clamp(remaining / max(previousRemaining, 1e-5), 0.0, 1.0);
	history.r = mix(1.0, history.r, keep);
	history.g *= keep * keep;
	// A normal quad-phase gap must not repeatedly erase accumulated maturity.
	if (missing > pc.aoMissingHoldFrames) history.b *= pc.aoMissingAgeDecay;
	history.a = missing;
	return history;
}

vec4 accumulateAO(SceneData s, RenderTargetIDs rt, ivec2 p, ivec2 full)
{
	vec2 observation = aoReadObservation(rt, p);
	float currentAO = observation.x;
	float confidence = observation.y;
	float raw = SampleTextureFetch(rt.depthResolvedID, p, 0).r;
	float z = SampleTextureFetch(rt.linearizedHiZID, p, 0).r;
	if (!(raw > 0.0) || !aoFinite(z) || z <= 0.0) return aoEmptyHistory();

	vec3 normalVS = octDecode(SampleTextureFetch(rt.viewNormalsID, p, 0).rg * 2.0 - 1.0);
	vec3 normalWS = normalize(mat3(s.invView) * normalVS);
	vec4 history;
	float footprintSupport;
	bool valid = aoReprojectHistory(s, rt, p, full, z, normalWS, history, footprintSupport);

	// Preserve the existing slider's meaning: zero disables history reuse.
	float maxHistoryWeight = clamp(pc.aoHistoryWeight, 0.0, 0.99);
	if (!valid || maxHistoryWeight <= 0.0)
	{
		if (confidence < pc.aoMinObservation) return aoEmptyHistory();
		return vec4(currentAO, pc.aoInitialVariance, confidence, 0.0);
	}

	if (confidence < pc.aoMinObservation) return aoCarryMissing(history);

	// Reduce maturity when only a small portion of the history footprint survives.
	float age = history.b * smoothstep(0.0, pc.aoHistoryFootprintMinSupport, footprintSupport);
	float variance = clamp(history.g, 0.0, 0.25);
	float historyAO = history.r;

	float low;
	float high;
	float spatialVariance;
	if (confidence > pc.aoClipConfidence &&
		aoNeighborhood(rt, p, full, z, normalVS, low, high, spatialVariance))
	{
		// The current spatial neighborhood is not a noise-free reference.
		// Retain a margin based on historical noise, even on a spatially flat patch.
		float sigma = min(sqrt(max(variance, spatialVariance)), pc.aoClipMaxSigma);
		float margin = pc.aoClipMargin + pc.aoClipSigma * sigma;
		float clipped = clamp(historyAO, max(0.0, low - margin), min(1.0, high + margin));
		float strength = smoothstep(pc.aoClipConfidence, 1.0, confidence);
		float correction = abs(clipped - historyAO) * strength;
		historyAO = mix(historyAO, clipped, strength);

		// Strong supported changes shorten history so moving occlusion can respond.
		float reactive = clamp(correction / max(pc.aoReactiveThreshold, sigma), 0.0, 1.0);
		age = mix(age, min(age, 1.0), reactive);
	}

	// With confidence=1, the steady-state current weight is at least 1-W.
	// Missing/weak observations never receive the weight of a full observation.
	float maxAge = min(pc.aoMaxHistorySamples, maxHistoryWeight / (1.0 - maxHistoryWeight));
	age = min(age, maxAge);
	float rate = confidence / max(age + confidence, AO_SUPPORT_EPSILON);
	float delta = currentAO - historyAO;
	float mean = mix(historyAO, currentAO, rate);
	float newVariance = (1.0 - rate) * (variance + rate * delta * delta);
	return vec4(clamp(mean, 0.0, 1.0), clamp(newVariance, 0.0, 0.25),
		min(age + confidence, pc.aoMaxHistorySamples), 0.0);
}

void main()
{
	SceneData s = getSceneData();
	RenderTargetIDs rt = s.renderTargetIDs;
	ivec2 full = SampleTextureSize(rt.bentAOUpsampledID, 0);
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, full))) return;

	vec4 result = accumulateAO(s, rt, p, full);
	imageStore(outAOHistory, p, result);
	vec4 bentAO = SampleTextureFetch(rt.bentAOUpsampledID, p, 0);
	bentAO.a = result.r;
	imageStore(outBentAO, p, bentAO);
}
