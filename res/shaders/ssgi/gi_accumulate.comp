#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/depth.glsl"
#include "../include/ssgi_push.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inGIRaw;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D inGIHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform sampler2D inHiZ;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D inVelocity;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5) uniform sampler2D inPrevDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_6) uniform sampler2D inViewNormals;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_7) uniform sampler2D inPrevViewNormals;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_8) uniform sampler2D inAORaw;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rgba16f) writeonly uniform image2D outGIHistory;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_2) writeonly uniform image2D outAO;

void main()
{
	SceneData s = getSceneData();

	ivec2 full = ivec2(s.renderExtentSize.xy);
	ivec2 halfExt = (full + 1) / 2;

	ivec2 hp = ivec2(gl_GlobalInvocationID.xy);

	if (any(greaterThanEqual(hp, halfExt))) return;

	ivec2 fp = min(hp * 2 + aoQuadPhase(s.temporal.x, IsTAAEnabled()), full - 1);
	vec2 uv = (vec2(fp) + 0.5) / vec2(full);

	vec4 cur = texelFetch(inGIRaw, hp, 0);
	vec4 hist = vec4(0);

	bool valid = s.temporal.y == 1u && cur.a > 0.0;

	vec2 prevUV = uv - texelFetch(inVelocity, fp, 0).rg;

	valid = valid &&
		all(greaterThanEqual(prevUV, vec2(0))) &&
		all(lessThan(prevUV, vec2(1)));

	if (valid)
	{
		float z = texelFetch(inHiZ, fp, 0).r;

		vec3 v = cheapReconstructViewPos(uv, z, s.ndcToViewMult, s.ndcToViewAdd);
		vec3 w = (s.invView * vec4(v, 1)).xyz;

		float expected = -(s.prevView * vec4(w, 1)).z;
		float raw = textureLod(inPrevDepth, prevUV, 0).r;
		float previous = screenToViewDepth(raw, s.depthLinearizeMult, s.depthLinearizeAdd);

		vec3 n = normalize(mat3(s.invView) * octDecode(texelFetch(inViewNormals, fp, 0).rg * 2.0 - 1.0));
		vec3 pn = normalize(mat3(s.prevInvView) * octDecode(textureLod(inPrevViewNormals, prevUV, 0).rg * 2.0 - 1.0));

		valid = raw > 0.0 &&
			expected > 0.0 &&
			abs(previous - expected) < expected * pc.giReprojTolerance &&
			dot(n, pn) > 0.9;

		if (valid)
		{
			hist = textureLod(inGIHistory, prevUV, 0);
			hist.rgb *= getPreExposureDelta();
			valid = hist.a > 0.0;
		}
	}

	vec3 low = cur.rgb;
	vec3 high = cur.rgb;

	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			vec4 q = texelFetch(inGIRaw, clamp(hp + ivec2(x, y), ivec2(0), halfExt - 1), 0);

			if (q.a > 0.0)
			{
				low = min(low, q.rgb);
				high = max(high, q.rgb);
			}
		}
	}

	hist.rgb = clamp(hist.rgb, low, high);

	float rate = valid ? clamp(pc.giTemporalAlpha, 0.01, 1.0) : 1.0;
	vec3 rgb = mix(hist.rgb, cur.rgb, rate);

	// Confidence tracks CURRENT evidence; reprojection never invents observations.
	imageStore(outGIHistory, hp, vec4(rgb, clamp(cur.a, 0.0, 1.0)));
	imageStore(outAO, hp, vec4(texelFetch(inAORaw, hp, 0).r));
}