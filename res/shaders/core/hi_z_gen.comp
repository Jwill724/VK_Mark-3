#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Mip 0 source: resolved depth (float)
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D inDepthResolved;

// Mip N source: previous HZB mip (packed uint)
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform usampler2D inHiZPacked;

// Output: current HZB mip (packed uint)
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform uimage2D outMip;

layout(push_constant) uniform DepthPyramidPush {
	vec2 invSize; // 1.0 / current mip res
	uint mipLevel;
	float pad0;
} pc;

void main()
{
	ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);

	float srcWidthF = 1.0 / pc.invSize.x;
	float srcHeightF = 1.0 / pc.invSize.y;

	int srcWidth = int(srcWidthF + 0.5);
	int srcHeight = int(srcHeightF + 0.5);

	int dstWidth;
	int dstHeight;

	if (pc.mipLevel == 0u)
	{
		dstWidth = srcWidth;
		dstHeight = srcHeight;
	}
	else
	{
		dstWidth = max(1, srcWidth / 2);
		dstHeight = max(1, srcHeight / 2);
	}

	if (dstCoord.x >= dstWidth || dstCoord.y >= dstHeight) return;

	if (pc.mipLevel == 0u)
	{
		float rawDepth = texelFetch(inDepthResolved, dstCoord, 0).r;

		// In ratio scheme both min/max in [0,1]. For mip0 min==max.
		float depth01 = clamp(rawDepth, 0.0, 1.0);

		uint packed = packHZB(depth01, depth01);
		imageStore(outMip, dstCoord, uvec4(packed, 0u, 0u, 0u));
	}
	else
	{
		ivec2 maxSrc = ivec2(srcWidth - 1, srcHeight - 1);
		ivec2 base   = dstCoord * 2;

		// Odd source dimension: floor division orphans the last row/column — no dst texel
		// would ever read it. Widen the footprint to 3 on that axis so it folds in.
		int extraX = srcWidth  & 1;
		int extraY = srcHeight & 1;

		float outMin =  1e30;
		float outMax = -1e30;

		for (int y = 0; y <= 1 + extraY; ++y)
		for (int x = 0; x <= 1 + extraX; ++x)
		{
			ivec2 c = clamp(base + ivec2(x, y), ivec2(0), maxSrc);
			float lo, hi;
			unpackHZB(texelFetch(inHiZPacked, c, 0).r, lo, hi);
			outMin = min(outMin, lo);   // furthest occluder in reverse-z
			outMax = max(outMax, hi);   // nearest
		}

		imageStore(outMip, dstCoord, uvec4(packHZB(outMin, outMax), 0u, 0u, 0u));
	}
}
