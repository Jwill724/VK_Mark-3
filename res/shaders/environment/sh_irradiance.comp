#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"

layout(local_size_x = 64) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform samplerCube skyboxImage;

layout(push_constant) uniform PC
{
	uint envIndex;
} pc;

const uint FACE_RES = 128u;

float AreaElement(float x, float y)
{
	return atan(x * y, sqrt(x * x + y * y + 1.0));
}

vec3 FaceDirection(uint face, vec2 uv)
{
	switch (face)
	{
		case 0u: return vec3( 1.0,  -uv.y, -uv.x);
		case 1u: return vec3(-1.0,  -uv.y,  uv.x);
		case 2u: return vec3( uv.x,  1.0,   uv.y);
		case 3u: return vec3( uv.x, -1.0,  -uv.y);
		case 4u: return vec3( uv.x, -uv.y,  1.0);
		default: return vec3(-uv.x, -uv.y, -1.0);
	}
}

shared vec3 sSH[9][64];

void main()
{
	uint tid = gl_LocalInvocationIndex;

	vec3 sh[9];
	for (int i = 0; i < 9; ++i)
	{
		sh[i] = vec3(0.0);
	}

	float invRes = 1.0 / float(FACE_RES);
	float lod = max(log2(float(textureSize(skyboxImage, 0).x) * invRes), 0.0);

	uint perFace = FACE_RES * FACE_RES;
	uint total = perFace * 6u;

	for (uint idx = tid; idx < total; idx += 64u)
	{
		uint face = idx / perFace;
		uint rem  = idx % perFace;

		vec2 st = (vec2(float(rem % FACE_RES), float(rem / FACE_RES)) + 0.5) * invRes;
		vec2 uv = st * 2.0 - 1.0;

		vec3 dir = normalize(FaceDirection(face, uv));

		float x0 = uv.x - invRes;
		float y0 = uv.y - invRes;
		float x1 = uv.x + invRes;
		float y1 = uv.y + invRes;

		float dw =
			AreaElement(x0, y0) -
			AreaElement(x0, y1) -
			AreaElement(x1, y0) +
			AreaElement(x1, y1);

		vec3 L = textureLod(skyboxImage, dir, lod).rgb * dw;

		sh[0] += L * 0.282095;
		sh[1] += L * 0.488603 * dir.y;
		sh[2] += L * 0.488603 * dir.z;
		sh[3] += L * 0.488603 * dir.x;
		sh[4] += L * 1.092548 * dir.x * dir.y;
		sh[5] += L * 1.092548 * dir.y * dir.z;
		sh[6] += L * 0.315392 * (3.0 * dir.z * dir.z - 1.0);
		sh[7] += L * 1.092548 * dir.x * dir.z;
		sh[8] += L * 0.546274 * (dir.x * dir.x - dir.y * dir.y);
	}

	for (int i = 0; i < 9; ++i)
	{
		sSH[i][tid] = sh[i];
	}

	barrier();

	for (uint s = 32u; s > 0u; s >>= 1u)
	{
		if (tid < s)
		{
			for (int i = 0; i < 9; ++i)
			{
				sSH[i][tid] += sSH[i][tid + s];
			}
		}

		barrier();
	}

	if (tid == 0u)
	{
		SHIrradianceBuffer shBuf = getSHIrradianceBuffer();
		for (uint i = 0u; i < 9u; ++i) shBuf.shIrr[pc.envIndex].sh[i] = sSH[i][0];
	}
}
