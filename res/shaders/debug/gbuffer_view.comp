#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/barycentric.glsl"
#include "../include/visbuffer.glsl"
#include "../include/depth.glsl"
#include "../include/shadow.glsl"
#include "../include/debug_views.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform usampler2D visBuffer;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D  gbAlbedoRough;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform usampler2D gbNormalMaterial;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_4) uniform sampler2D  depthTex;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_5) uniform sampler2D  aoFinal;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_6) uniform sampler2D  contactShadowMask;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rgba16f) writeonly uniform image2D outColor;

void main()
{
	SceneData    scene = getSceneData();
	DebugToggles debug = getDebugToggles();

	uvec2 gid    = gl_GlobalInvocationID.xy;
	uvec2 vpSize = uvec2(scene.renderExtentSize.xy);
	if (any(greaterThanEqual(gid, vpSize))) return;

	if (debug.debugView == DBG_OFF) return;

	bool temporalOn = (scene.taaMipParams.x < 0.0) && debugViewTemporal(debug.debugView);

	ivec2 px = ivec2(gid);
	vec2  uv = (vec2(gid) + 0.5) / vec2(vpSize);

	uvec2 ids      = texelFetch(visBuffer, px, 0).xy;
	float rawDepth = texelFetch(depthTex,  px, 0).r;
	bool  isSky    = (ids.x == VIS_INVALID);

	vec3 result = vec3(0.0);

	if (!isSky)
	{
		switch (debug.debugView)
		{
			case DBG_ALBEDO:
				result = texelFetch(gbAlbedoRough, px, 0).rgb;
				break;

			case DBG_NORMALS:
				result = unpackGBufferNormal(texelFetch(gbNormalMaterial, px, 0).r);
				break;

			case DBG_ROUGHNESS:
				result = vec3(texelFetch(gbAlbedoRough, px, 0).a);
				break;

			case DBG_METALLIC:
				result = vec3(unpackGBufferMetal(texelFetch(gbNormalMaterial, px, 0).r));
				break;

			case DBG_SSAO:
				result = temporalOn
					? vec3(texture(aoFinal, uv).a)
					: vec3(texelFetch(aoFinal, ivec2(uv * vec2(textureSize(aoFinal, 0))), 0).a);
				break;

			case DBG_SS_SHADOWS:
				result = vec3(texture(contactShadowMask, uv).r);
				break;

			case DBG_CASCADES:
			{
				ViewReconstructResult r = reconstructWorldPosFromDepth(
					uv, rawDepth, scene.invProj, scene.invView);

				ShadowCSM csm = getShadowCSM();
				uint cascadeIdx = cascadeViewDepthSplit(
					r.viewDepth, uint(csm.params.y), csm.cascadeSplits);

				result = debugCascadeOverlay(texelFetch(gbAlbedoRough, px, 0).rgb, cascadeIdx);
				break;
			}

			case DBG_VIS_INSTANCE:
				result = debugHashColor(visInstanceID(ids.x));
				break;

			case DBG_VIS_TRIANGLE:
				result = debugHashColor(visMeshletID(ids.y) * 131u + visLocalTri(ids.y));
				break;

			case DBG_VIS_LOD:
				result = debugLodColor(visLODIndex(ids.x));
				break;

			case DBG_MESHLETS:
				result = debugHashColor(visMeshletID(ids.y));
				break;

			default:
				break;
		}
	}

	imageStore(outColor, px, vec4(result, 1.0));
}
