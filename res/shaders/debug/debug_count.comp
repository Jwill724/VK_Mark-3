#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform DebugCountPush
{
	uint debugMask;
	uint streamFilter;
} pc;

void main()
{
	uint visibleID = gl_GlobalInvocationID.x;
	uint total = getIndirectDispatchBuffer().args[INDIRECT_DISPATCH_SLOT_SCATTER].w;
	if (visibleID >= total) return;

	VisibleInstance vis = getVisibleInstanceBuffer().visibles[visibleID];

	// only instances in the requested streams
	if ((vis.visMask & pc.streamFilter) == 0u) return;

	if ((pc.debugMask & DEBUG_MASK_OBB) != 0u)
	{
		uint slot = atomicAdd(getDebugCountersBuffer().counters.itemCount, 1u);
		if (slot >= DEBUG_MAX_ITEMS) return;

		// color by stream membership: red = camera visible, cyan = transparent
		uint color = ((vis.visMask & VIS_PRIMARY_TRANSPARENT) != 0u)
			? packDebugColor(vec4(0.0, 1.0, 1.0, 1.0))
			: packDebugColor(vec4(1.0, 0.0, 0.0, 1.0));

		DebugItem item;
		item.instanceID  = vis.instanceID;
		item.drawType    = DEBUG_MASK_OBB;
		item.colorPacked = color;
		getDebugItemsBuffer().items[slot] = item;
	}
}
