#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/depth.glsl"
#include "../include/nrd_common.glsl"
#include "../include/rt_shadow_common.glsl"

const int   MASK_TILE          = 8;
const float MASK_MARGIN_SCALE  = 1.0;

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D uDepth;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) uniform writeonly uimage2D uInvalidMask;

bool rayHitsAABB(vec3 origin, vec3 invDir, vec3 bmin, vec3 bmax, float tMax)
{
	vec3 t0 = (bmin - origin) * invDir;
	vec3 t1 = (bmax - origin) * invDir;

	vec3 tn = min(t0, t1);
	vec3 tf = max(t0, t1);

	float tNear = max(max(tn.x, tn.y), tn.z);
	float tFar  = min(min(tf.x, tf.y), tf.z);

	return tFar >= max(tNear, 0.0) && tNear <= tMax;
}

void main()
{
	ivec2 dst    = ivec2(gl_GlobalInvocationID.xy);
	ivec2 dstRes = imageSize(uInvalidMask);
	if (any(greaterThanEqual(dst, dstRes))) return;

	ShadowInvalidVolumesBuffer vols = getShadowInvalidVolumesBuffer();
	uint volumeCount = min(vols.count, MAX_SHADOW_INVALID_VOLUMES);

	if (volumeCount == 0u)
	{
		imageStore(uInvalidMask, dst, uvec4(0u));
		return;
	}

	SceneData sd  = getSceneData();
	ivec2     res = ivec2(sp.resolution);

	vec3 sunDir  = normalize(sd.sunlightDirection.xyz);
	vec3 safeDir = mix(sunDir, vec3(1e-6), lessThan(abs(sunDir), vec3(1e-6)));
	vec3 invDir  = 1.0 / safeDir;

	float tMax = sp.shadow.sunTangentWS.w;

	const ivec2 corners[4] = ivec2[4](
		ivec2(0, 0),
		ivec2(MASK_TILE - 1, 0),
		ivec2(0, MASK_TILE - 1),
		ivec2(MASK_TILE - 1, MASK_TILE - 1));

	vec3  origins[4];
	float margins[4];
	int   sampleCount = 0;

	ivec2 base = dst * MASK_TILE;

	for (int i = 0; i < 4; ++i)
	{
		ivec2 px = min(base + corners[i], res - 1);

		float depth = texelFetch(uDepth, px, 0).r;
		if (depth <= DEPTH_EPSILON_REVERSED_Z) continue;

		vec2 uv = (vec2(px) + 0.5) * sp.invResolution;

		ViewReconstructResult vr =
			reconstructWorldPosFromDepth(uv, depth, sd.invProj, sd.invView);

		origins[sampleCount] = vr.pos;
		margins[sampleCount] = vr.viewDepth * sd.tanHalfFov.y
							 * (float(MASK_TILE) / sp.resolution.y) * MASK_MARGIN_SCALE;
		++sampleCount;
	}

	uint dirty = 0u;

	for (uint v = 0u; v < volumeCount && dirty == 0u; ++v)
	{
		vec3 bmin = vols.volumes[v].boundsMin;
		vec3 bmax = vols.volumes[v].boundsMax;

		for (int s = 0; s < sampleCount; ++s)
		{
			vec3 m = vec3(margins[s]);
			if (rayHitsAABB(origins[s], invDir, bmin - m, bmax + m, tMax))
			{
				dirty = 1u;
				break;
			}
		}
	}

	imageStore(uInvalidMask, dst, uvec4(dirty));
}