#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"
#include "../include/depth.glsl"
#include "../include/shadow.glsl"

layout(local_size_x = 256) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform usampler2D inHiZ;

shared uint sMinRaw[256]; // reverse-z: min raw = farthest
shared uint sMaxRaw[256]; // reverse-z: max raw = nearest

void main()
{
	uint tid = gl_LocalInvocationIndex;
	SceneData sceneData = getSceneData();

	int maxMip = textureQueryLevels(inHiZ) - 1;

	// reduce lowest Hi-Z mip to global depth range
	ivec2 mipSize = textureSize(inHiZ, maxMip);
	uint texelCount = uint(mipSize.x * mipSize.y);

	float localMin = 1.0; // raw reverse-z
	float localMax = 0.0;

	for (uint i = tid; i < texelCount; i += 256u)
	{
		ivec2 coord = ivec2(int(i % uint(mipSize.x)), int(i / uint(mipSize.x)));
		uint packed = texelFetch(inHiZ, coord, maxMip).r;

		float dMin, dMax;
		unpackHZB(packed, dMin, dMax);

		// skip empty texels (nothing rendered = raw 0 in reverse-z clear)
		if (dMax > DEPTH_EPSILON_REVERSED_Z)
		{
			localMin = min(localMin, dMin);
			localMax = max(localMax, dMax);
		}
	}

	sMinRaw[tid] = floatBitsToUint(localMin);
	sMaxRaw[tid] = floatBitsToUint(localMax);
	barrier();

	for (uint s = 128u; s > 0u; s >>= 1u)
	{
		if (tid < s)
		{
			sMinRaw[tid] = min(sMinRaw[tid], sMinRaw[tid + s]);
			sMaxRaw[tid] = max(sMaxRaw[tid], sMaxRaw[tid + s]);
		}
		barrier();
	}

	if (tid >= MAX_CASCADES) return;

	float nearPlane = sceneData.cameraClips.x;
	float farPlane  = sceneData.cameraClips.y;

	float minRaw = uintBitsToFloat(sMinRaw[0]);
	float maxRaw = uintBitsToFloat(sMaxRaw[0]);

	ShadowCullDataBuffer outData = getShadowCullDataBuffer();
	ShadowCSM csm = getShadowCSM();

	bool depthValid = (sceneData.temporal.z != 0u) && (maxRaw > DEPTH_EPSILON_REVERSED_Z);

	// reverse-z: min raw = farthest visible, max raw = nearest visible
	float farVisible  = depthValid ? linearizeDepth(minRaw, nearPlane, farPlane) : farPlane;
	float nearVisible = depthValid ? linearizeDepth(maxRaw, nearPlane, farPlane) : nearPlane;

	// small temporal pad — Hi-Z is last frame's depth
	farVisible  = min(farVisible * 1.05, farPlane);
	nearVisible = max(nearVisible * 0.95, nearPlane);

	uint c = tid;

	float sliceNear = (c == 0u) ? nearPlane : csm.cascadeSplits[c - 1u] * CASCADE_BLEND_FRACTION;
	float sliceFar  = csm.cascadeSplits[c];

	// clamp slice to visible depth range
	sliceNear = max(sliceNear, nearVisible);
	sliceFar  = min(sliceFar,  farVisible);

	// cascade deactivation — no visible receivers in this depth band
	if (sliceNear >= sliceFar)
	{
		// write inactive
		if      (c == 0u) outData.data.cascadeActive.x = 0u;
		else if (c == 1u) outData.data.cascadeActive.y = 0u;
		else if (c == 2u) outData.data.cascadeActive.z = 0u;
		else              outData.data.cascadeActive.w = 0u;
		return;
	}

	vec3 lsMin = vec3( 1e30);
	vec3 lsMax = vec3(-1e30);

	mat4 invView = sceneData.invView;
	mat4 lightView = csm.cascadeLightViews[c];

	for (uint zi = 0u; zi < 2u; ++zi)
	{
		float z = (zi == 0u) ? sliceNear : sliceFar;
		float x = z * sceneData.tanHalfFov.x;
		float y = z * sceneData.tanHalfFov.y;

		for (uint corner = 0u; corner < 4u; ++corner)
		{
			vec3 viewPos = vec3(
				(corner & 1u) != 0u ?  x : -x,
				(corner & 2u) != 0u ?  y : -y,
				-z); // RH view space looks down -Z

			vec3 worldPos = (invView * vec4(viewPos, 1.0)).xyz;
			vec3 lsPos    = (lightView * vec4(worldPos, 1.0)).xyz;

			lsMin = min(lsMin, lsPos);
			lsMax = max(lsMax, lsPos);
		}
	}

	outData.data.receiverLSMin[c] = vec4(lsMin, 0.0);
	outData.data.receiverLSMax[c] = vec4(lsMax, 0.0);

	if      (c == 0u) outData.data.cascadeActive.x = 1u;
	else if (c == 1u) outData.data.cascadeActive.y = 1u;
	else if (c == 2u) outData.data.cascadeActive.z = 1u;
	else              outData.data.cascadeActive.w = 1u;
}
