#version 460

#extension GL_GOOGLE_include_directive    : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/clustered.glsl"
#include "../include/culling.glsl"
#include "../include/common.glsl"

layout(local_size_x = 256) in;

void main()
{
	uint lightIndex = gl_GlobalInvocationID.x;

	DebugToggles debug = getDebugToggles();
	SceneData scene = getSceneData();
	bool IsHiZInvalid = scene.temporal.y == 0; // Using regular temporal check
	uint lightCount = debug.activeLightCount;
	if (lightIndex >= lightCount || IsHiZInvalid) return;

	LocalLight light = getLightBuffer().lights[lightIndex];

	// skip flashlight when toggled off
	if ((light.flags & LIGHT_FLAG_FLASHLIGHT_OFF) != 0u) return;

	mat4 vp = scene.viewProjUnjittered;

	vec4 pl, pr, pb, pt;
	get_frustum_side_planes(vp, pl, pr, pb, pt);

	if (!sphere_in_side_planes(light.position, light.radius, pl, pr, pb, pt)) return;

	// near plane check — point light behind camera with small radius should be culled
	// extract near plane from vp row2 + row3
	vec4 row2 = vec4(vp[0][2], vp[1][2], vp[2][2], vp[3][2]);
	vec4 row3 = vec4(vp[0][3], vp[1][3], vp[2][3], vp[3][3]);
	vec4 nearPlane = row3 + row2;
	nearPlane /= max(length(nearPlane.xyz), 1e-8);
	float dNear = dot(nearPlane.xyz, light.position) + nearPlane.w;
	if (dNear < -light.radius) return;

	uint writeIndex = atomicAdd(getVisibleLightCountBuffer().count, 1u);
	if (writeIndex >= lightCount) return;

	getVisibleLightIDsBuffer().ids[writeIndex] = lightIndex;
}
