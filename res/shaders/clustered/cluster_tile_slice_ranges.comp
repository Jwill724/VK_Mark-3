#version 460

#extension GL_GOOGLE_include_directive    : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/depth.glsl"
#include "../include/clustered.glsl"
#include "../include/common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform usampler2D inHiZ;

void main() {
	uvec2 tileCoord = uvec2(gl_GlobalInvocationID.xy);

	ClusteredData clustered = getClusteredData();
	SceneData scene = getSceneData();

	bool isHiZInvalid = scene.temporal.y == 0;

	if ((tileCoord.x >= clusteredData.tileCountX ||
		tileCoord.y >= clusteredData.tileCountY) ||
		isHiZInvalid) return;

	ClusterTileSliceRanges tsrBuf = getClusterTileSliceRangesBuffer();

	uvec2 viewportSize = uvec2(scene.renderExtentSize.xy);

	const uint maxSlice = clusteredData.zSlices - 1u;
	const uint tileIndex = tileCoord.y * clusteredData.tileCountX + tileCoord.x;

	uvec2 tilePixelMin = uvec2(
		tileCoord.x * clusteredData.tileSizeX,
		tileCoord.y * clusteredData.tileSizeY
	);

	uvec2 tilePixelMax = uvec2(
		min(tilePixelMin.x + (clusteredData.tileSizeX - 1u), viewportSize.x - 1u),
		min(tilePixelMin.y + (clusteredData.tileSizeY - 1u), viewportSize.y - 1u)
	);

	bool partialY = (tilePixelMax.y != tilePixelMin.y + (clusteredData.tileSizeY - 1u));

	if (partialY && tileCoord.y == clusteredData.tileCountY - 1u) {
		// Bottom partial row: be conservative
		tsrBuf.ranges[tileIndex] = uvec2(0u, maxSlice);
		return;
	}

	uint tileSizeMax = max(clusteredData.tileSizeX, clusteredData.tileSizeY);
	float mipLevelF = floor(log2(float(max(tileSizeMax, 1u))));

	float maxMip  = float(textureQueryLevels(inHiZ) - 1);
	uint mipLevel = uint(clamp(mipLevelF, 0.0, maxMip));

	uvec2 mipPixelMin = tilePixelMin >> mipLevel;
	uvec2 mipPixelMax = tilePixelMax >> mipLevel;

	ivec2 mipSizeI = textureSize(inHiZ, int(mipLevel));
	uvec2 mipSizeU = uvec2(max(mipSizeI.x, 1), max(mipSizeI.y, 1));

	mipPixelMin = min(mipPixelMin, mipSizeU - 1u);
	mipPixelMax = min(mipPixelMax, mipSizeU - 1u);

	float minLinearDepth = scene.cameraClips.y;

	for (uint y = mipPixelMin.y; y <= mipPixelMax.y; y++) {
		for (uint x = mipPixelMin.x; x <= mipPixelMax.x; x++) {
			uvec4 sampleDepth = texelFetch(inHiZ, ivec2(x, y), int(mipLevel));
			float nearRaw = unpackNearRaw(sampleDepth.r);
			float nearLinear = linearizeDepth(nearRaw, scene.cameraClips.x, scene.cameraClips.y);
			minLinearDepth = min(minLinearDepth, nearLinear);
		}
	}

	float nearPlane = scene.cameraClips.x;
	float farPlane  = scene.cameraClips.y;

	float transparentNear = uintBitsToFloat(
		getClusterTileTransparentNearBuffer().nearDepth[tileIndex]);

	float rangeNear = min(minLinearDepth, transparentNear);

	uint minSlice = depthToSliceLog(
		clamp(rangeNear, nearPlane, farPlane), nearPlane, farPlane, clusteredData.zSlices);
	minSlice = min(minSlice, clusteredData.zSlices - 1u);

//	tsrBuf.ranges[tileIndex] = uvec2(minSlice, maxSlice);
	tsrBuf.ranges[tileIndex] = uvec2(0u, maxSlice);
}
