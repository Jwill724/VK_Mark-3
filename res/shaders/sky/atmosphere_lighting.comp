#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_separate_shader_objects : require

#include "../include/common.glsl"
#include "../include/atmosphere_lighting.glsl"
#include "../include/lighting.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rgba32f) writeonly uniform image2D outLighting;

const uint ATM_FILTER_SAMPLES = 128u;

vec2 atmosphereHammersley(uint i)
{
	return vec2(
		(float(i) + 0.5) / float(ATM_FILTER_SAMPLES),
		float(bitfieldReverse(i)) * 2.3283064365386963e-10);
}

mat3 atmosphereTangentBasis(vec3 N)
{
	vec3 axis = abs(N.y) < 0.999
		? vec3(0.0, 1.0, 0.0)
		: vec3(1.0, 0.0, 0.0);

	vec3 T = normalize(cross(axis, N));
	vec3 B = cross(N, T);

	return mat3(T, B, N);
}

vec3 atmosphereFilterDiffuse(vec3 N)
{
	mat3 basis = atmosphereTangentBasis(N);
	vec3 sum = vec3(0.0);

	for (uint i = 0u; i < ATM_FILTER_SAMPLES; ++i)
	{
		vec2 xi = atmosphereHammersley(i);

		float phi = 2.0 * PI * xi.x;
		float r = sqrt(xi.y);

		vec3 local = vec3(
			r * cos(phi),
			r * sin(phi),
			sqrt(max(1.0 - xi.y, 0.0)));

		sum += atmosphereSkyRadiance(basis * local);
	}

	// Cosine-weighted hemisphere sampling: pdf = cos(theta) / PI.
	return sum * (PI / float(ATM_FILTER_SAMPLES));
}

vec3 atmosphereFilterSpecular(vec3 R, float roughness)
{
	if (roughness <= 0.0)
		return atmosphereSkyRadiance(R);

	mat3 basis = atmosphereTangentBasis(R);

	float alpha = roughness * roughness;
	float alpha2 = alpha * alpha;

	vec3 sum = vec3(0.0);
	float weight = 0.0;

	for (uint i = 0u; i < ATM_FILTER_SAMPLES; ++i)
	{
		vec2 xi = atmosphereHammersley(i);

		float phi = 2.0 * PI * xi.x;

		float cosTheta = sqrt(
			(1.0 - xi.y)
			/ max(1.0 + (alpha2 - 1.0) * xi.y, 1e-6));

		float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));

		vec3 H = basis * vec3(
			sinTheta * cos(phi),
			sinTheta * sin(phi),
			cosTheta);

		// Split-sum prefilter assumes V = N = R.
		vec3 L = normalize(2.0 * dot(R, H) * H - R);
		float NoL = max(dot(R, L), 0.0);

		if (NoL > 0.0)
		{
			sum += atmosphereSkyRadiance(L) * NoL;
			weight += NoL;
		}
	}

	return sum / max(weight, 1e-6);
}

void main()
{
	ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
	ivec2 extent = imageSize(outLighting);

	if (any(greaterThanEqual(cell, extent))) return;

	int layer = cell.y / ATM_LIGHT_HEIGHT;
	ivec2 localCell = ivec2(cell.x, cell.y % ATM_LIGHT_HEIGHT);

	vec2 uv = (vec2(localCell) + 0.5)
		/ vec2(ATM_LIGHT_WIDTH, ATM_LIGHT_HEIGHT);

	vec3 direction = atmosphereLatLongDirection(uv);
	vec3 result;

	if (layer == ATM_DIFFUSE_LAYER)
	{
		result = atmosphereFilterDiffuse(direction);
	}
	else
	{
		float roughness = float(layer) / float(ATM_SPEC_LEVELS - 1);
		result = atmosphereFilterSpecular(direction, roughness);
	}

	imageStore(outLighting, cell, vec4(max(result, vec3(0.0)), 1.0));
}