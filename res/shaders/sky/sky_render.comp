#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rgba16f) writeonly uniform image2D outAtmosphereHDR;
layout(push_constant) uniform AtmosphereSky
{
	AtmosphereParameters parameters;
	vec4 placement;
	vec4 scattering;
	vec4 sun;
	uvec4 options;
} pc;

vec3 sunPixelRadiance(SceneData scene, vec2 pixel, vec2 extent, vec3 centerRay,
	vec3 sunDir, vec3 up, float h)
{
	float alpha = pc.sun.x;
	vec3 rayX = atmosphereViewRay((pixel + vec2(1.5, 0.5)) / extent, scene.invProj, scene.invView);
	vec3 rayY = atmosphereViewRay((pixel + vec2(0.5, 1.5)) / extent, scene.invProj, scene.invView);
	float footprint = max(length(rayX - centerRay) + length(rayY - centerRay), 1e-6);
	if (dot(centerRay, sunDir) < cos(alpha + footprint)) return vec3(0.0);

	// Full-resolution area coverage. LUT filtering never widens the solar disk.
	vec3 sumT = vec3(0.0);
	float cosRadius = cos(alpha);
	for (int y = 0; y < 4; ++y)
	{
		for (int x = 0; x < 4; ++x)
		{
			vec2 offset = (vec2(x, y) + 0.5) * 0.25;
			vec3 ray = atmosphereViewRay((pixel + offset) / extent, scene.invProj, scene.invView);
			if (dot(ray, sunDir) >= cosRadius)
				sumT += sampleAtmosphereTransmittanceHM(pc.parameters, h, dot(up, ray));
		}
	}

	vec3 solarE = max(scene.sunlightColor.rgb * scene.sunlightColor.a * pc.sun.y, vec3(0.0));
	// For a uniform disk, E_normal = L_disk * pi * sin(alpha)^2.
	float sinRadius = sin(alpha);
	vec3 diskL = solarE / (PI * sinRadius * sinRadius);
	return diskL * (sumT * (1.0 / 16.0));
}

void main()
{
	ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
	ivec2 extent = imageSize(outAtmosphereHDR);
	if (any(greaterThanEqual(cell, extent))) return;

	SceneData scene = getSceneData();
	vec3 sunDir = normalize(scene.sunlightDirection.xyz);
	vec3 dir = atmosphereViewRay((vec2(cell) + 0.5) / vec2(extent), scene.invProj, scene.invView);
	float h;
	vec3 up;
	atmosphereCamera(pc.parameters, scene.cameraPos.xyz, pc.placement, h, up);

	uint skyID = getAtmosphereResourceUBO().textureIDs.y;
	vec2 skyExtent = vec2(textureSize(TEX2D(skyID), 0));
	vec2 uv = atmosphereSkyViewUV(pc.parameters, h, dir, up, sunDir, skyExtent);
	vec3 sky = SampleTextureLod(skyID, uv, 0.0).rgb;
	vec3 disk = sunPixelRadiance(scene, vec2(cell), vec2(extent), dir, sunDir, up, h);
	vec3 color = (sky + disk) * getPreExposure();
	imageStore(outAtmosphereHDR, cell, vec4(min(color, vec3(65504.0)), 1.0));
}
