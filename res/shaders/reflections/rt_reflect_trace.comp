#version 460

#extension GL_GOOGLE_include_directive : require

#include "../include/nrd_common.glsl"
#include "../include/reflect_common.glsl"
#include "../include/depth.glsl"

layout(local_size_x = 64) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_READ_1) uniform sampler2D  uDepth;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_2) uniform sampler2D  uRoughness;
layout(set = PUSH_SET, binding = PUSH_BINDING_READ_3) uniform usampler2D uNormalMetal;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1, rgba16f) uniform writeonly image2D uRadiance;

void main()
{
	RTRayListBuffer rays = getRTRayListBuffer();

	if (gl_GlobalInvocationID.x >= rtRayCount(rays, RT_RAY_SLOT_REFLECT, rp.rayCapacity)) return;

	uint  idx = rp.rayBase + gl_GlobalInvocationID.x;
	ivec2 px  = ivec2(rtUnpackPixel(rays.payload[idx]));
	vec2  uv  = (vec2(px) + 0.5) * rp.halfResTexel;

	SceneData     sd    = getSceneData();
	RTShadeParams shade = rtReflectParamsFromPush();

	float depth     = textureLod(uDepth, uv, 0.0).r;
	float roughness = textureLod(uRoughness, uv, 0.0).r;
	float alpha     = max(roughness * roughness, 1e-3);

	vec3 N = unpackGBufferNormal(textureLod(uNormalMetal, uv, 0.0).r);

	ViewReconstructResult vr = reconstructWorldPosFromDepth(uv, depth, sd.invProj, sd.invView);

	vec3  P        = vr.pos;
	float viewZ    = vr.viewDepth;

	vec3  toCam    = sd.cameraPos.xyz - P;
	float viewDist = length(toCam);
	vec3  V        = toCam / max(viewDist, 1e-6);

	mat3 TBN = buildTBN(N);
	vec3 H   = TBN * sampleGGXVNDF(normalize(V * TBN), alpha,
		rtNoise(px, rp.hilbertLutID, sd.temporal.x, RT_NOISE_OFFSET_REFLECTION));
	vec3 L   = reflect(-V, H);

	if (dot(N, L) <= 0.0)
	{
		imageStore(uRadiance, px, vec4(0.0));
		return;
	}

	vec3  radiance  = vec3(0.0);
	float firstHitT = rp.shadow.rayTMax;

	vec3 rayOrigin = P + N * rtSurfaceBias(rp.shadow, viewDist);
	vec3 rayDir    = L;

	vec3  throughput = vec3(1.0);
	float pathRough  = roughness;
	float pathDist   = viewDist;

	const float mipBias = 1.0;

	for (uint bounce = 0u; bounce < rp.maxBounces; ++bounce)
	{
		rayQueryEXT rq;
		rayQueryInitializeEXT(rq, sceneTLAS, gl_RayFlagsCullBackFacingTrianglesEXT,
			RT_MASK_SHADOW_CASTERS,
			rayOrigin, rp.shadow.rayTMin, rayDir, rp.shadow.rayTMax);

		while (rayQueryProceedEXT(rq))
		{
			if (rtAlphaTestPasses(
					rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false),
					rayQueryGetIntersectionPrimitiveIndexEXT(rq, false),
					rayQueryGetIntersectionBarycentricsEXT(rq, false),
					mipBias))
				rayQueryConfirmIntersectionEXT(rq);
		}

		if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT)
		{
			radiance += throughput * rtSampleSky(rayDir, pathRough, rp.skyboxID);
			break;
		}

		float t = rayQueryGetIntersectionTEXT(rq, true);
		if (bounce == 0u) firstHitT = t;
		pathDist += t;

		HitSurface s = rtUnpackHit(
			rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true),
			rayQueryGetIntersectionPrimitiveIndexEXT(rq, true),
			rayQueryGetIntersectionBarycentricsEXT(rq, true),
			t, rayOrigin, rayDir, mipBias);

		if ((bounce + 1u >= rp.maxBounces) || (s.roughness > rp.bounceRoughnessCutoff))
		{
			radiance += throughput * rtShadeAnalytic(s, rayDir, shade);
			break;
		}

		vec3  hitV     = -rayDir;
		float hitAlpha = max(s.roughness * s.roughness, 2.25e-4);
		mat3  hitTBN   = buildTBN(s.normal);

		vec3 hitH = hitTBN * sampleGGXVNDF(
			normalize(hitV * hitTBN), hitAlpha,
			SpatioTemporalNoise(px + RT_NOISE_OFFSET_REFLECTION, rp.hilbertLutID, rp.noiseIndex + bounce * 17u));

		vec3  nextDir = reflect(rayDir, hitH);
		float hitNoL  = dot(nextDir, s.normal);

		if (hitNoL <= 0.0)
		{
			radiance += throughput * rtShadeAnalytic(s, rayDir, shade);
			break;
		}

		radiance += throughput * s.emissive;

		float hitDielF0 = DielectricF0(s.mat.ior, s.mat.specularFactor);
		vec3  F0  = mix(vec3(hitDielF0), s.albedo, s.metallic);
		float VoH = max(dot(hitV, hitH), 1e-4);
		vec3  Fr  = F0 + (vec3(1.0) - F0) * pow(1.0 - VoH, 5.0);

		throughput *= Fr * smithG1(hitNoL, hitAlpha);
		pathRough = min(1.0, sqrt(pathRough * pathRough + s.roughness * s.roughness));

		if (rtMaxComp(throughput) < 0.02) break;

		rayOrigin = s.position + s.normal * rtSurfaceBias(rp.shadow, pathDist);
		rayDir    = nextDir;
	}

	float normHitDist = REBLUR_FrontEnd_GetNormHitDist(firstHitT, viewZ, roughness);
	imageStore(uRadiance, px,
		REBLUR_FrontEnd_PackRadianceAndNormHitDist(radiance * getPreExposure(), normHitDist));
}
