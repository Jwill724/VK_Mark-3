#version 460

#extension GL_ARB_separate_shader_objects : require
#extension GL_GOOGLE_include_directive : require

#include "../include/common.glsl"
#include "../include/world_probe_cache.glsl"
#include "../include/depth.glsl"
#include "../include/clustered.glsl"
#include "../include/pbr.glsl"
#include "../include/atmosphere_lighting.glsl"
#include "../include/lighting.glsl"
#include "../include/shadow.glsl"
#include "../include/froxel.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = PUSH_SET, binding = PUSH_BINDING_WRITE_1) writeonly uniform image3D outScatterRaw;

layout(push_constant) uniform FroxelPush
{
	vec2  froxelClips;

	float density;
	float scatteringStrength;
	float extinction;
	float heightFalloff;

	float asymmetryFactor;
	float jitterStrength;
	float historyWeight;
	float localLightIntensity;
} pc;

vec3 evaluateFogLight(LocalLight light, vec3 worldPos, vec3 viewDir, vec3 cameraPos, float g)
{
	vec3  toLight = light.position - worldPos;
	float dist    = length(toLight);
	if (dist >= light.radius) return vec3(0.0);

	vec3  L         = toLight / max(dist, 1e-6);
	float attenDist = max(dist, light.sourceRadius);

	float atten = radiusAttenuation(dist, light.radius)
				* inverseSquareAttenuation(attenDist);

	if ((light.flags & LIGHT_FLAG_SPOT) != 0u)
		atten *= spotConeFactor(light.direction, L, light.innerCos, light.outerCos);

	if (atten <= 0.0) return vec3(0.0);

	vec3 radiance = light.color * light.intensity * atten;

	if (luminance(radiance) < LIGHT_CULL_NITS) return vec3(0.0);

	return radiance * phaseHenyeyGreenstein(dot(viewDir, L), g);
}

void main()
{
	ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(cell, ivec2(FROXEL_X, FROXEL_Y)))) return;

	SceneData            scene         = getSceneData();
	ClusteredData        clusteredData = getClusteredData();
	VolumetricShadowInfo volShadow     = getVolumetricShadowInfo();

	uint visibleLightCount = getVisibleLightCountBuffer().count;

	vec2 uv = (vec2(cell) + 0.5) / vec2(FROXEL_X, FROXEL_Y);

	vec3 viewRayVS = cheapReconstructViewPos(uv, 1.0, scene.ndcToViewMult, scene.ndcToViewAdd);
	vec3 rayWS     = mat3(scene.invView) * viewRayVS;
	vec3 viewDir   = normalize(rayWS);

	vec3 camPos = scene.cameraPos.xyz;
	vec3 sunDir = normalize(scene.sunlightDirection.xyz);

	float cosSun   = dot(viewDir, sunDir);
	float sunPhase = phaseHenyeyGreenstein(cosSun, pc.asymmetryFactor);

	vec3 skyRadiance = (
		atmosphereDiffuseIrradiance(vec3( 1.0,  0.0,  0.0)) +
		atmosphereDiffuseIrradiance(vec3(-1.0,  0.0,  0.0)) +
		atmosphereDiffuseIrradiance(vec3( 0.0,  1.0,  0.0)) +
		atmosphereDiffuseIrradiance(vec3( 0.0, -1.0,  0.0)) +
		atmosphereDiffuseIrradiance(vec3( 0.0,  0.0,  1.0)) +
		atmosphereDiffuseIrradiance(vec3( 0.0,  0.0, -1.0))
	) * (1.0 / (6.0 * PI));

	mat2  poissonRotation = createHashTemporal(vec2(cell), scene.temporal.x);
	float jitter = (temporalInterleavedGradientNoise(
		vec2(cell), int(scene.temporal.x), float(scene.temporal.y)) - 0.5)
		* clamp(pc.jitterStrength, 0.0, 1.0);

	float nearZ = pc.froxelClips.x;
	float farZ  = pc.froxelClips.y;

	vec2  pixelCoord   = uv * scene.renderExtentSize.xy;
	uvec2 viewportSize = uvec2(scene.renderExtentSize.xy);

	bool localLightsOn = (visibleLightCount > 0u) && (pc.localLightIntensity > 0.0);

	float preExposure = getPreExposure();

	for (uint s = 0u; s < FROXEL_Z; ++s)
	{
		float viewDepth = froxelSliceToDepth(float(s) + 0.5 + jitter, nearZ, farZ);
		vec3  worldPos  = camPos + rayWS * viewDepth;

		float density = pc.density * exp(-pc.heightFalloff * max(worldPos.y, 0.0));
		float sigmaE = max(density * pc.extinction, 0.0);

		float shadowTerm = sampleVolumetricShadowMap(volShadow, worldPos, poissonRotation);

		vec3 ambientRadiance = sampleWorldProbeFogAmbient(worldPos);

		vec3 scatter = ambientRadiance * pc.scatteringStrength;

		vec3 sunColor = atmosphereSunAtWorld(worldPos);

		scatter += sunColor
			* sunPhase
			* pc.scatteringStrength
			* shadowTerm;

		if (localLightsOn)
		{
			ClusterGrid grid = computeClusterGrid(
				pixelCoord, viewDepth, viewportSize,
				clusteredData.tileSizeX, clusteredData.tileSizeY,
				clusteredData.tileCountX, clusteredData.tileCountY,
				clusteredData.zSlices,
				scene.cameraClips.x, scene.cameraClips.y);

			uint count = min(getVolClusterCountsBuffer().counts[grid.clusterIndex],
							 clusteredData.maxLightsPerCluster);
			uint offset = getVolClusterOffsetsBuffer().offsets[grid.clusterIndex];

			VolClusterLightIDs idsBuf = getVolClusterLightIDsBuffer();
			LightBuffer        lightBuf = getLightBuffer();

			vec3 local = vec3(0.0);

			for (uint i = 0u; i < count; ++i)
			{
				LocalLight light = lightBuf.lights[idsBuf.lightIDs[offset + i]];

				if ((light.flags & LIGHT_FLAG_MASK_ONLY) != 0u) continue;
				if ((light.flags & LIGHT_FLAG_FLASHLIGHT_OFF) != 0u) continue;

				local += evaluateFogLight(light, worldPos, viewDir, camPos, pc.asymmetryFactor);
			}

			scatter += local * pc.localLightIntensity;
		}

		imageStore(outScatterRaw, ivec3(cell, int(s)),
			vec4(scatter * density * preExposure, sigmaE));
	}
}